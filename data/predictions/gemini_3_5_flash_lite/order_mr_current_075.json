      ],
      "text": "विषय:- माघी गणेशोत्सव - २०२३ साजरा करणेबाबत."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        75.1,
        141.46,
        498.26,
        141.46,
        498.26,
        169.24,
        75.1,
        169.24
      ],
      "text": "माघी गणेशोत्सव २५ जानेवारी, २०२३ पासून साजरा होणार आहे. माघी गणेशोत्सवाबाबत\nमा. मनपा आयुक्तांनी पुढीलप्रमाणे मार्गदर्शक सूचना प्रसारित करण्यास मंजुरी दिली आहे -"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        102.51,
        173.45,
        498.26,
        173.45,
        498.26,
        282.91,
        102.51,
        282.91
      ],
      "text": "1. आगामी माघी गणेशोत्सवादरम्यान असलेला अल्प कालावधी व तदनंतर लगेचच साजरा होणाऱ्या\nप्रजासत्ताक दिनाच्या पूर्वतयारीमध्ये पोलिसांची असलेली व्यस्तता, याबाबी विचारات घेवून माघी\nगणेशोत्सवासाठी प्राप्त होणाऱ्या अर्जांपैकी ज्या मंडळांना गतवर्षी परवानगी देण्यात आली आहे,\nअशा मंडळांचे अर्ज स्थानिक/वाहतूक पोलिसांकडे न पाठवता, मागील वर्षाची परवानगी ग्राह्य\nधरून विभाग कार्यालयामार्फत छाननी करून परवानगी देण्यात यावी. नव्याने / प्रथमतः अर्ज\nकरणाऱ्या मंडळांच्या अर्जाच्या बाबतीत मात्र स्थानिक/वाहतूक पोलिसांचे ना-हरकत प्रमाणपत्र\nघेण्यात यावे."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        100.13,
        286.28,
        496.47,
        286.28,
        496.47,
        329.22,
        100.13,
        329.22
      ],
      "text": "2. विभागीय सहाय्यक आयुक्तांनी त्यांच्या अधिपात्याखालील विभागात माघी गणेशोत्सवादरम्यान\nउभारayच्या कृत्रिम तलावांची आवश्यकता पडताळावी व आवश्यक सुविधा उपलब्ध करून\nदेण्यात याव्यात."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        98.94,
        333.43,
        495.87,
        333.43,
        495.87,
        362.9,
        98.94,
        362.9
      ],
      "text": "3. माघी गणेशोत्सवादरम्यान मंडप उभारणीच्या परवानगीसाठी प्रतिवर्षप्रमाणे असंगणकीय\nकार्यपद्धतीचा अवलंब करावा."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        98.94,
        366.27,
        495.87,
        366.27,
        495.87,
        411.74,
        98.94,
        411.74
      ],
      "text": "4. कोविड-१९ किंवा त्याच्या विविध प्रकारांच्या प्रादुर्भावाचा पुनरुद्भवाचा संभाव्य धोका विचारात\nघेता, शासनाने उत्सव कालावधीत कोविड-१९ या सादरोगाच्या पार्श्वभूमीवर निर्बंध जारी केल्यास\nत्याचे पालन केले जाईल, अशा आशयाचे हमीपत्र मंडळांकडून स्वीकारावे."
    },
