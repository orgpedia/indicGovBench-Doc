      ],
      "text": "OFFICE MEMORANDUM."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        141.01,
        195.34,
        526.58,
        195.34,
        526.58,
        250.92,
        141.01,
        250.92
      ],
      "text": "The undersigned is directed to circulate for the information\nof all Ministries of the Government of India a copy of the minutes\nrecorded by the Prime Minister relating to -"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        164.82,
        264.39,
        531.34,
        264.39,
        531.34,
        309.86,
        164.82,
        309.86
      ],
      "text": "(1) The appointment of Shri R.R.Diwakar, Member of the\nConstituent Assembly, as Minister of State for\nInformation and Broadcasting with effect from the\n7th December, 1948."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        166.6,
        312.38,
        533.72,
        312.38,
        533.72,
        356.17,
        166.6,
        356.17
      ],
      "text": "(2) The appointment of Dr. Balkrishan V.Keskar, Member of the\nConstituent Assembly, as Deputy Minister with effect\nfrom the 7th December, 1948. He will be attached to\nthe Ministry of External Affairs & Commonwealth Relations."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        326.66,
        376.37,
        499.2,
        376.37,
        499.2,
        432.79,
        326.66,
        432.79
      ],
      "text": "(E.C.Donoghue)\nfor Joint Secretary to the Cabinet."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        142.2,
        453.0,
        442.08,
        453.0,
        442.08,
        483.31,
        142.2,
        483.31
      ],
      "text": "To\nAll Secretaries to the Government of India."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
