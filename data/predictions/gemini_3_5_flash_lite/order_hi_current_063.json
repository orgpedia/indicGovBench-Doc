      ],
      "text": "Shift Incharge एवं उनके सहायको के कर्तव्यः-\n1\nप्रत्येक टीम उनके निर्धारित ड्यूटी चार्ट के अनुसार संभाग- द्वितीय, जयपुर में स्थित केन्द्रीय बाढ़\nनियंत्रण कक्ष में अपनी उपस्थिति देंगे।"
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        121.38,
        168.4,
        481.95,
        168.4,
        481.95,
        186.92,
        121.38,
        186.92
      ],
      "text": "2\nप्रत्येक टीम अपना स्थान तब ही छोड़ेंगे जब अगली टीम आ जायेगी इस दौरान उनसे\nकम्युनिकेशन करेंगे।"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        120.79,
        187.77,
        481.95,
        187.77,
        481.95,
        258.49,
        120.79,
        258.49
      ],
      "text": "राज्य के किसी भी क्षेत्र में सड़क, पुलिया एवं भवन के क्षतिग्रस्त होने/यातायात अवरुद्ध होने की\nसूचना प्राप्त होने पर केन्द्रीय नियंत्रण कक्ष प्रभारी उनको रजिस्टर में दर्ज करेंगे व दैनिक रिपोर्ट\nसबंधित मुख्य अभियंता को प्रस्तुत करेंगे तथा बाढ़ आने पर/बाढ़ आपदा घोषित होने की सूचना\nप्राप्त होने पर तत्काल दूरभाष/मोबाईल द्वारा मुख्य अभियंता (विशेष परियोजना) को अवगत\nकरवायेंगे एवं किसी भी क्षेत्र से समस्याओं की सूचना प्राप्त होते ही संबंधित अधीक्षण\nअभियंता/अधिशाषी अभियंता को समस्या के निस्तारण के लिए तुरन्त सूचित करेंगे।"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        119.6,
        259.34,
        481.95,
        259.34,
        481.95,
        297.23,
        119.6,
        297.23
      ],
      "text": "4\nसंभाग कार्यालय से बाढ़ से अवरुद्ध सड़क मार्गों से संबंधित सूचना निर्धारित प्रपत्र-अ में\nदैनिक रूप से संलग्न कर उसे प्रतिदिन सूचना मुख्य अभियंता (विशेष परियोजना) एवं समस्त\nमुख्य अभियंताओं को प्रेषित करेंगे।"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        104.12,
        301.44,
        474.81,
        301.44,
        474.81,
        367.11,
        104.12,
        367.11
      ],
      "text": "यह आदेश 15 जून 2026 से तुरन्त प्रभाव से लागू होंगे एय उक्त अधिकारी / कर्मचारी श्रीमान\nमुख्य अभियन्ता (एस.एस.) सा०नि०वि० राजस्थान जयपुर के पत्र क्रमांक सी.ई. (एस.एस.)/पलड\nमैनेंज़मेंट/2026/डी-83 दिनांक 07.05.2026 की अनुपालना सुनिश्चित करते हुए कर्तव्यों का निर्वहन करेंगे।\nउक्त अधिकारी/कर्मचारी बिना सक्षम स्वीकृति के न तो अवकाश पर रहेंगे न व मुख्यालय छोड़ेंगे।\nसंलग्न :- ड्यूटी चार्ट।"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
