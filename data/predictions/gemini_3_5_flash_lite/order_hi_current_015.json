    },
    {
      "id": 14,
      "type": "text",
      "order": 14,
      "poly": [
        104.12,
        516.15,
        570.61,
        516.15,
        570.61,
        586.03,
        104.12,
        586.03
      ],
      "text": "प्रकरण पंजीबद्ध हो तो उसका विवरण देवें ।\nदीपावली व अन्य धार्मिक पर्व पर रात्रि 08.00 बजे से 10.00 बजे तक ग्रीन पटाखों (पर्यावरण\nअनुकूल फटाखों) के संबंध में आमजन में जागरूकता लाने एवं प्रचार प्रसार अन्तर्गत क्या-क्या\nकारवाही की गई है, इसका विवरण देवें ।"
    },
