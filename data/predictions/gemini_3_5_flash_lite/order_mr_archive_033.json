        379.14,
        582.38,
        379.14,
        637.47,
        282.49,
        637.47
      ],
      "text": "Bserद\n( रा.न.पारदे )"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        272.34,
        642.19,
        393.02,
        642.19,
        393.02,
        673.67,
        272.34,
        673.67
      ],
      "text": "शासनाचे उप सचिव,\nवित्त विभाग."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
