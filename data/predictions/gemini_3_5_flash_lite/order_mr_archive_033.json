      ],
      "text": "पेट्रोल, तेल व वंगण यांच्या वापराच्या\nबाबततील मर्यादा विहित करणे."
    },
    {
      "id": 1,
      "type": "text",
      "order": 1,
      "poly": [
        112.67,
        79.49,
        392.49,
        79.49,
        392.49,
        159.76,
        112.67,
        159.76
      ],
      "text": "महाराष्ट्र शासन,\nवित्त विभाग,\nपरिपत्रक क्र. एमसीए-१०८२/सी आर-९७-जीएन-५,\nमंत्रालय, मुंबई- ४००, ०३२,\nदिनांक २२ डिसेंबर १९८३."
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        75.83,
        177.86,
        125.49,
        177.86,
        125.49,
        192.81,
        75.83,
        192.81
      ],
      "text": "परिपत्रक:"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        71.56,
        209.34,
        503.56,
        209.34,
        503.56,
        369.1,
        71.56,
        369.1
      ],
      "text": "पेट्रोलच्या वापरात झालेली बेसुमार वाढ व क्रुड तेलाची व अन्य\nपेट्रोल पदार्थांची मर्यादित उपलब्धता लक्षात घेता आणि एकस्पता साधण्याच्या\nहेतूने मुद्धा प्रशासकीय विभाग/दुय्यम कार्यालये यांच्या अखत्यारीखालील\nक्षेत्र अधिका-यांकडे जास्त वापरात असलेल्या व अन्य अधिका-यांकडे वापरात\nअसलेल्या मोटार गाड्यांना लागणारे पेट्रोल, तेल व वंगणाबाबत आर्थिक\nमर्यादा निश्चित करण्याचा प्रश्न काही काळापासून शासनाच्या\nविचारार्थीन होता."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        16.55,
        380.12,
        488.61,
        380.12,
        488.61,
        560.34,
        16.55,
        560.34
      ],
      "text": "शासनाने आता असे ठरविले आहे की, प्रत्येक प्रशासकीय विभागाने\nत्यांच्या आणि त्यांच्या दुय्यम कार्यालयाच्या नियंत्रणाखाली असलेल्या\nमोटार गाड्यांच्या वापरासाठी पेट्रोलवर झालेल्या खर्चाचा सुदम अंदाज\nघ्यावा आणि वित्त विभागाच्या (व्यय कार्यासने) संमतीने सन १९७८-७९\nमध्ये लागलेल्या पेट्रोल खर्चाच्या ८५ प्रतिशत मर्यादा क्षेत्र अधिका-यांकडे\nवापरात असलेल्या मोटार गाड्यांच्या बाबतीत व ६३ प्रतिशत मर्यादा\nअन्य मोटार गाड्यांच्या बाबतीत\n2 निश्चित कराव्यात. परिपत्रकाची इंग्रजी प्रत माहितीकरिता सोबत\nजोडलेली आहे."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        108.94,
        568.21,
        419.19,
        568.21,
        419.19,
        587.89,
        108.94,
        587.89
      ],
      "text": "महाराष्ट्राचे राज्यपाल यांच्या आदेशानुसार व नावाने,"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        282.49,
