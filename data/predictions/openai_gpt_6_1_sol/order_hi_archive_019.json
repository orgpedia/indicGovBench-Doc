    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        49.39,
        124.62,
        538.48,
        124.62,
        538.48,
        196.19,
        49.39,
        196.19
      ],
      "text": "प्रमुख अभियन्ता, ग्रामीण सड़क, लो०नि०वि०, लखनऊ का पत्रांक–60/01जीएस०एस०/15 दिनांक 19.\n2.2016 द्वारा सृष्टि वेबसाइट पर खण्डों से अपडेटेड डाटा के अनुरूप आगणनों के परीक्षण के संबंध में दिशा–निर्देश\nनिर्गत किये गये थे एवं अपेक्षा की गयी थी कि मुख्यालय को प्रेषित किये जाने वाले आगणनों में क्षेत्रीय एवं वृत्तीय\nकार्यालयों द्वारा मार्ग की श्रेणी, लम्बाई, क्रस्ट, लेपित सतह की चौड़ाई एवं नवीनीकरण का वर्ष आदि विवरण को सृष्टि\nवेबसाइट पर खण्डों से अपडेटेड डाटा से पुष्टि उपरान्त प्रेषित किये जायें।"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        52.36,
        197.03,
        537.88,
        197.03,
        537.88,
        297.23,
        52.36,
        297.23
      ],
      "text": "उल्लेखनीय है कि किसी भी मार्ग के निर्माण के प्रारम्भ से लेकर समय–समय पर सम्पादित विभिन्न कार्यों की\nविधिवत प्रविष्टि मार्ग विशेष से संबंधित मार्ग परिलेख (डी०टू०आई०) में प्रत्येक वर्ष की जाती है एवं उससे संबंधित\nविवरण की साफ्ट एवं हार्ड प्रतियाँ प्रमुख अभियन्ता कार्यालय को प्रेषित की जाती रही हैं। सृष्टि वेबसाइट के\nशुभारम्भान्त समस्त मार्गों के प्रत्येक किमी० का अध्यावधिक विवरण वेबसाइट के विभिन्न कालमों में अंकित करने के\nनिर्देश दिये गये थे एवं तदनुसार ही वेबसाइट पर उपलब्ध डाटा एवं आगणन में संलग्न प्रारूप-16 में उल्लिखित\nमार्ग की क्रस्ट, नवीनीकरण का माह/वर्ष, यातायात गणना के आंकड़ों का मिलान कर मुख्यालय स्तर पर आगणनों\nके परीक्षण की कार्यवाही सम्पादित की जा रही है।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        57.72,
        298.07,
        535.5,
        298.07,
        535.5,
        325.01,
        57.72,
        325.01
      ],
      "text": "क्षेत्र द्वारा प्रेषित आगणनों में चेकलिस्ट (प्रपत्र-1क) में अंकित मार्ग के विभिन्न किमी० में क्रस्ट, नवीनीकरण\nका माह/वर्ष, यातायात गणना के आंकड़े तथा वेबसाइट पर उपलब्ध आंकड़ों में भिन्नता नहीं होनी चाहिए।"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        58.91,
        325.85,
        534.31,
        325.85,
        534.31,
        407.53,
        58.91,
        407.53
      ],
      "text": "अतः एतद्द्वारा निर्देशित किया जाता है कि भविष्य में आगणनों के प्रेषण के पूर्व यह सुनिश्चित किया जाए कि\nसृष्टि की वेबसाइट पर वही डाटा अंकित हो जो पूर्व में मार्ग परिलेख में अंकित है तथा यदि किन्हीं परिस्थितियों में\nमार्ग के अभिलेखों, क्रस्ट एवं वास्तविक क्रस्ट में भिन्नता हो तो क्रस्ट की कमी हेतु सक्षम स्तर से अनुमोदन एवं\nउत्तरदायी अधिकारियों एवं कर्मचारियों के नाम व पदनाम के साथ उत्तरदायित्व के निर्धारणोपरान्त ही मार्ग के\nचौड़ीकरण/सुदृढ़ीकरण के आगणन प्रेषित किये जाएं। इसी प्रकार मार्ग के यातायात गणना एवं सी०बी०आर० की भी\nसर्वोच्च प्राथमिकता के आधार पर परीक्षणोपरान्त सृष्टि की वेबसाइट पर अपलोड किया जाना सुनिश्चित किया जाए।"
    },
