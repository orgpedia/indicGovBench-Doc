    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        130.31,
        288.81,
        515.87,
        288.81,
        515.87,
        382.27,
        130.31,
        382.27
      ],
      "text": "”प्रमुख अभियंता एवं शासन के सक्षम / क्षेत्राधिकार की समस्त निविदाओं के निविदा\nप्रारूप (Draft N.I.T.) का अनुमोदन मुख्य अभियंता द्वारा एवं कार्यपालन यंत्री के\nसक्षम/क्षेत्राधिकार की सड़क कार्यों की निविदाओं के निविदा प्रारूप (Draft N.I.T.)\nका अनुमोदन अधीक्षण यंत्री द्वारा किया जायेगा । मुख्य अभियंता, अधीक्षण यंत्री एवं\nकार्यपालन यंत्री के सक्षम / क्षेत्राधिकार की शेष अन्य सभी निविदाओं के निविदा\nप्रारूप का अनुमोदन कंडिका 2.080 के तहत यथावत किया जायेगा ।”"
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        45.81,
        362.9,
        125.55,
        362.9,
