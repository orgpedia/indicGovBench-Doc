        414.26,
        316.54,
        414.26,
        316.54,
        438.68,
        96.98,
        438.68
      ],
      "text": "३.सदर जमिनीवर येणे जाणेसाठी रस्ता उपलब्ध आहे."
    },
    {
      "id": 21,
      "type": "text",
      "order": 21,
      "poly": [
        96.39,
        433.63,
        302.86,
        433.63,
        302.86,
        457.21,
        96.39,
        457.21
      ],
      "text": "४.सदर जमिनीवर पाण्याची स्वतंत्र व्यवस्था आहे."
    },
    {
      "id": 22,
      "type": "text",
      "order": 22,
      "poly": [
        95.2,
        453.0,
        285.0,
