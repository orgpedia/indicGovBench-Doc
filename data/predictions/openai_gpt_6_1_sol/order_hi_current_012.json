        335.12,
        72.59,
        335.12
      ],
      "html": "<table><thead><tr><td>स०क्र०</td><td>उपयुक्ततासूचीक्र०/वरिष्ठ</td><td>उपनिरीक्षक कानाम</td><td>जिला/इकाईका नाम</td><td>नवीन पदस्थापनाइकाई</td><td>नाम पृथक कियेजाने का कारण</td></tr></thead><tbody><tr><td>01</td><td>392/1637</td><td>अशोक लहरी</td><td>जिला धार</td><td>अजाक पुलिसमुख्यालय, भोपाल</td><td>असंचयी सजाप्रभावशील होने से।</td></tr><tr><td>02</td><td>412/1676</td><td>संजय खलको</td><td>जिला अनूपपुर</td><td>पीटीएस उमरिया</td><td>असंचयी सजाप्रभावशील होने से।</td></tr><tr><td>03</td><td>449/1739</td><td>मोहित लालसोनवानी</td><td>जिला शहडोल</td><td>पुलिस दूरसंचारसंगठन,मुख्यालय,भोपाल</td><td>विभागीय जाँच01/24 लंबितहोने से।</td></tr></tbody></table>"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        72.0,
