      ],
      "text": "विषय:- माघी गणेशोत्सव – २०२३ साजरा करणेबाबत."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        74.5,
        141.46,
        499.45,
        141.46,
        499.45,
        174.29,
        74.5,
        174.29
      ],
      "text": "माघी गणेशोत्सव २५ जानेवारी, २०२३ पासून साजरा होणार आहे. माघी गणेशोत्सवाबाबत\nमा.मनपा आयुक्तांनी पुढीलप्रमाणे मार्गदर्शक सूचना प्रसारित करण्यास मंजुरी दिली आहे –"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        101.32,
        174.29,
        499.45,
        174.29,
        499.45,
        280.39,
        101.32,
        280.39
      ],
      "text": "1. आगामी माघी गणेशोत्सवादरम्यान असलेला अल्प कालावधी व तदनंतर लगेचच साजरा होणाऱ्या\nप्रजासत्ताक दिनाच्या पूर्वतयारीमध्ये पोलिसांची असलेली व्यस्तता, याबाबी विचारात घेऊन माघी\nगणेशोत्सवासाठी प्राप्त होणाऱ्या अर्जांपैकी ज्या मंडळांना गतवर्षी परवानगी देण्यात आली आहे,\nअशा मंडळांचे अर्ज स्थानिक/वाहतूक पोलिसांकडे न पाठवता, मागील वर्षीची परवानगी ग्राह्य\nधरून विभाग कार्यालयामार्फत छाननी करून परवानगी देण्यात यावी. नव्याने / प्रथमतः अर्ज\nकरणाऱ्या मंडळांच्या अर्जांच्या बाबतीत मात्र स्थानिक/वाहतूक पोलिसांचे ना-हरकत प्रमाणपत्र\nघेण्यात यावे."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        98.94,
        287.12,
        498.26,
        287.12,
        498.26,
        330.06,
        98.94,
        330.06
      ],
      "text": "2. विभागीय सहाय्यक आयुक्तांनी त्यांच्या अधिपत्याखालील विभागात माघी गणेशोत्सवादरम्यान\nउभारावयाच्या कृत्रिम तलावांची आवश्यकता पडताळावी व आवश्यक सुविधा उपलब्ध करून\nदेण्यात याव्यात."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        98.94,
        335.12,
        497.06,
        335.12,
        497.06,
        363.74,
        98.94,
        363.74
      ],
      "text": "3. माघी गणेशोत्सवादरम्यान मंडप उभारणीच्या परवानगीसाठी प्रतिवर्षीप्रमाणे असंगणकीय\nकार्यपद्धतीचा अवलंब करावा."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        98.34,
        367.11,
        496.47,
        367.11,
        496.47,
        414.26,
        98.34,
        414.26
      ],
      "text": "4. कोविड-१९ किंवा त्याच्या विविध प्रकारांच्या प्रादुर्भावाचा पुनरुद्भवाचा संभाव्य धोका विचारात\nघेता, शासनाने उत्सव कालावधीत कोविड-१९ या साथरोगाच्या पार्श्वभूमीवर निर्बंध जारी केल्यास\nत्याचे पालन केले जाईल, अशा आशयाचे हमीपत्र मंडळांकडून स्वीकारावे."
    },
