      ],
      "text": "मुंबई वित्तीय नियम १९५९ मध्ये\nसुधारणा करण्याबाबत."
    },
    {
      "id": 1,
      "type": "text",
      "order": 1,
      "poly": [
        148.7,
        72.8,
        246.0,
        72.8,
        246.0,
        106.1,
        148.7,
        106.1
      ],
      "text": "महाराष्ट्र शासन,\nवित्त विभाग,"
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        55.2,
        107.2,
        380.3,
        107.2,
        380.3,
        144.8,
        55.2,
        144.8
      ],
      "text": "निर्णय क्रमांक: एफएनआर-१०८३/प्र. क्र. १३५/ कोषागारे-६,\nमंत्रालय, मुंबई ४०० ०३२, दिनांक २३ सप्टेंबर १९८७."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        165.7,
        156.4,
        221.0,
        156.4,
        221.0,
        175.1,
        165.7,
        175.1
      ],
      "text": "नि र्ण य"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        9.8,
        186.4,
        471.5,
        186.4,
        471.5,
        239.6,
        9.8,
        239.6
      ],
      "text": "शासन असा आदेश देत आहे की, मुंबई वित्तीय नियम १९५९, प्रकरणा क्र. ११ मधील खाली नमूद केलेल्या नियमांत त्यासमोर दर्शविल्याप्रमाणे सुधारणा करण्यात यावी."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        40.5,
        251.2,
        490.8,
        251.2,
        490.8,
        559.1,
        40.5,
        559.1
      ],
      "text": "नियम क्रमांक १३३ :- उप नियम [तीन] मधील \"OR BOAT \" हे शब्द गाळण्यात यावेत.\n— उपनियम [सात] मध्ये विवरणापत्राच्या बहिःस्थ ओळीतील \"OR MOTOR BOAT\" हे शब्द गाळण्यात यावेत.\nनियम क्रमांक १३६ :- या नियमाच्या प्रारंभीच्या ओळीतील \" OR A MOTOR BOAT\" हे शब्द गाळण्यात यावेत.\n— उपनियम [२] मधील बहिःस्थ वाक्यांतील \"OR BOAT \" हे शब्द गाळण्यात यावेत.\n— उपनियम [३] मधील उपपरिच्छेद [b] पूर्णपणे काढण्यात यावा.\n— या नियमाच्या सर्व उपनियमांमध्ये/त्याखालील उपपरिच्छेदांमध्ये/टिप्पण्यांमध्ये \"CAR \" किंवा \"CARS \" या शब्दांपुढे येणारे \"OR BOAT \" / \"OR A MOTOR BOAT\" / \" OR THE BOAT \" / \"OR MOTOR BOATS \" हे शब्द गाळण्यात यावेत."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        41.6,
        568.9,
        413.6,
        568.9,
        413.6,
        591.0,
        41.6,
        591.0
      ],
      "text": "मुंबई वित्तीय नियमांत औपचारिक सुधारणा नंता करण्यात येतील."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        93.5,
        606.0,
        406.0,
        606.0,
        406.0,
        626.2,
        93.5,
        626.2
      ],
      "text": "महाराष्ट्राचे राज्यपाल यांच्या आदेशानुसार व नावाने,"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        102.6,
        651.0,
        214.6,
        651.0,
        214.6,
        702.4,
        102.6,
        702.4
      ],
      "text": "दि. द. पत्की,\nकार्यासन अधिकारी,\nवित्त विभाग."
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        261.1,
