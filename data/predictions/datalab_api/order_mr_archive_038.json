      ],
      "text": "अर्थसंलक्षणासु तसेतुद\nकेलेली असली पाहिजे.\nआखून दिलेल्या\nकार्यपद्धतीचे व सर्व-\nसाधारण निर्देशाचे/\nअटीचे पालन केले\nपाहिजे."
    },
    {
      "id": 1,
      "type": "text",
      "order": 1,
      "poly": [
        95.7,
        178.3,
        240.8,
        178.3,
        240.8,
        357.4,
        95.7,
        357.4
      ],
      "text": "कनिष्ठ न्यायालय व उच्च\nन्यायालयातील विधी\nअधिकारी व पॅनेल समुदायांना\nसध्या विहित नियमांतील\nमर्यादितपणे व फी मंजूर\nकरण्याचे प्राधिकार रु.१५००/-\nप्रतिदिन ह्या वित्तीय\nमर्यादित."
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        240.8,
        73.9,
        259.8,
        73.9,
        259.8,
        140.6,
        240.8,
        140.6
      ],
      "text": "वरीलप्रमाणे"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        250.1,
        278.3,
        269.1,
        278.3,
        269.1,
        353.3,
        250.1,
        353.3
      ],
      "text": "पूर्ण अधिकार"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        250.1,
        366.1,
        290.0,
        366.1,
        290.0,
        541.0,
        250.1,
        541.0
      ],
      "text": "सचिव, विधी व न्याय विभाग\nआणि विधी परामर्शी"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        320.5,
        69.8,
        433.3,
        69.8,
        433.3,
        153.5,
        320.5,
        153.5
      ],
      "text": "१] वरीलप्रमाणे\n२] संबंधित राज्याच्या\nविधी परामर्शी\nयांनी प्रमाणित\nकेलेल्या दरा-\nप्रमाणे."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        105.0,
        561.8,
        219.6,
        561.8,
        219.6,
        783.1,
        105.0,
        783.1
      ],
      "text": "विधी अधिकारी अथवा पॅनेल समुदायांनी\nयांना महाविधी अधिकारी [नियुक्ती\nतेवाकती व शुल्क] नियम १९६४ व\nआसकीय विधी विनियमक कामकाज चाल-\nविण्याचे नियम १९६४ यांत अंतर्भूत\nनसलेल्या फीचे दर मंजूर करणे."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        259.8,
        570.5,
        336.9,
        570.5,
        336.9,
        803.8,
        259.8,
        803.8
      ],
      "text": "४. कोणत्याही न्यायालयाने न्यायमित्र\n[ Amicus Curie ] म्हणून\nनेमलेल्या अधिवक्ताची न्यायालयाने\nप्रमाणित केलेली फी मंजूर करणे."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        339.5,
        553.5,
        419.1,
        553.5,
        419.1,
        803.8,
        339.5,
        803.8
      ],
      "text": "५. महाराष्ट्र राज्याबाहेरील न्यायालया-\nतमोरील प्रकरणात संबंधित राज्याच्या\nविधी अधिकाऱ्यांच्या फी व इतर\nवाढव्य खर्च मंजूर करणे."
    },
