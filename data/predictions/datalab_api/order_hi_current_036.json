        336.5
      ],
      "html": "<table><thead><tr><td rowspan=\"2\">क्र.सं०</td><td rowspan=\"2\">परियोजना का नाम</td><td rowspan=\"2\">अनुदान सं०/ लेखाशीर्षक</td><td rowspan=\"2\">वित्तीय वर्ष 2023-24 में पञ्चिपत्ति त बजट</td><td rowspan=\"2\">शासन द्वारा पदत्त स्वीकृति का संदभे शासनादेश सं० / दिनांक</td><td rowspan=\"2\">पशासकीय स्वीकृति की लागत (a) / गठित अनुबंध की लागत (b)</td><td rowspan=\"2\">अनुबन्धित लागत के आधार पर कार्य की पुनरीक्षित लागत</td><td rowspan=\"2\">गठित अनुबन्ध/ पुनरीक्षित लागत के आधार पर बचत (6(a)-7)</td><td rowspan=\"2\">अब तक प्रामाणिक अःवटन</td><td rowspan=\"2\">परियोजना पर आवंटन हेतु अवशेष धनराशि (पुनरीक्षित लागत सापेक्ष) (7-9)</td><td colspan=\"2\">वित्तीय वर्ष 2023-24 में</td></tr><tr><td>अनुदान सं०/ले या शीर्षक</td><td>अवमुक्त की जाने वाली पर तावित धनराशि</td></tr><tr><td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td><td>9</td><td>10</td><td>11</td><td>12</td></tr></thead><tbody><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr></tbody></table>"
    },
    {
      "id": 3,
      "type": "text",
