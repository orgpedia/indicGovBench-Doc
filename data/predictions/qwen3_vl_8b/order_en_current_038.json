      "poly": [
        73.78,
        185.24,
        515.87,
        185.24,
        515.87,
        241.65,
        73.78,
        241.65
      ],
      "text": "It has been observed that the designated Link Officers have been delaying the\n disposal of e-files pertaining to other Departments, thereby causing constraints in\n the smooth functioning of day-to-day official work, including matters of utmost\n urgency."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        73.78,
        255.13,
        515.87,
        255.13,
        515.87,
        296.38,
        73.78,
        296.38
      ],
      "text": "The Competent Authority has viewed the matter seriously and has directed\n that all e-files received by the designated Link Officers shall be attended to and\n disposed of immediately, without any delay."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        71.4,
        308.17,
        515.87,
        308.17,
        515.87,
        348.59,
        71.4,
        348.59
      ],
      "text": "Further, officers who are on duty-cum-tour to the mainland/inter-Islands shall\n continue to perform their routine duties and ensure timely disposal of e-files through\n e-Office."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        102.93,
        364.59,
        364.14,
        364.59,
        364.14,
        378.9,
        102.93,
        378.9
      ],
      "text": "The above instructions shall be adhered to strictly."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        102.93,
        392.37,
        402.82,
        392.37,
        402.82,
        407.53,
        102.93,
        407.53
      ],
      "text": "This issues with the approval of the Competent Authority."
