      "type": "text",
      "order": 15,
      "poly": [
        35.9,
        388.37,
        496.13,
        388.37,
        496.13,
        404.74,
        35.9,
        404.74
      ],
      "text": "कायम वा दीर्घ मुदतीवर लागणारी आपिण तीन व अधिक वर्ष अस्तित्वात असलेली ६० टक्के"
    },
    {
      "id": 16,
      "type": "text",
      "order": 16,
      "poly": [
        35.9,
        408.46,
        496.13,
        408.46,
        496.13,
        424.82,
        35.9,
        424.82
      ],
      "text": "पदे कायम करण्याची अनुमत देण्यात आली आहे. परंतु तदुपार करावयाच्या कार्यवाहीकडे"
    },
    {
      "id": 17,
      "type": "text",
      "order": 17,
      "poly": [
        35.9,
        428.54,
        477.09,
        428.54,
        477.09,
        444.91,
        35.9,
        444.91
      ],
      "text": "ब-यावशात कायालयप्रमुखानी व संबंधीत अधिकार्यांनी पाहिजे तेवढे लहान पुरविल्यामुळे"
    },
    {
      "id": 18,
      "type": "text",
      "order": 18,
      "poly": [
        35.9,
        448.63,
        496.13,
        448.63,
        496.13,
        465.0,
        35.9,
        465.0
      ],
      "text": "विद्या अन्य कारणानी हे काम कमी बर्थिक प्रमाणत अपूर्ण राहिले आहे. शासनाच्या असे"
    },
    {
      "id": 19,
      "type": "text",
      "order": 19,
      "poly": [
        35.9,
        468.72,
        477.09,
        468.72,
        477.09,
        485.09,
        35.9,
        485.09
      ],
      "text": "निर्देशांस आले आहे की, समूद्धर्षी कायम करता येण्याजोगी कितीतरी पदे अधापी"
    },
    {
      "id": 20,
      "type": "text",
      "order": 20,
      "poly": [
        35.9,
        488.81,
        477.09,
        488.81,
        477.09,
        505.18,
        35.9,
        505.18
      ],
      "text": "हंगामीच तेव्यांत येत आहेत. तसेब हंगामी पदे पुढे वारू तेव्यांसंबंधीचे आदेशाही वैक्षर"
    },
    {
      "id": 21,
      "type": "text",
      "order": 21,
      "poly": [
        35.9,
        508.9,
        422.69,
        508.9,
        422.69,
        525.26,
        35.9,
        525.26
      ],
      "text": "काढे जात नाहीत. याबाबत योग्य ती उपाययोजना करण्याची जरूरी आहे."
    },
    {
      "id": 22,
      "type": "text",
      "order": 22,
      "poly": [
        54.4,
        536.42,
        477.09,
        536.42,
        477.09,
        552.79,
        54.4,
        552.79
      ],
      "text": "३. ले पाहुता या संबंधीचे नेमोवेळी निर्मित केलेले आदेश विस्तृत व स्पष्ट आहेत,"
    },
    {
      "id": 23,
      "type": "text",
      "order": 23,
      "poly": [
        35.9,
        556.51,
        477.09,
        556.51,
        477.09,
        572.88,
        35.9,
        572.88
      ],
      "text": "व त्या संबंधी आपणसी स्पष्टीकरणाची गरज नाही. असे अभूती ज्याउरी या बाकीत"
    },
    {
      "id": 24,
      "type": "text",
      "order": 24,
      "poly": [
        35.9,
        576.6,
        477.09,
        576.6,
        477.09,
        592.97,
        35.9,
        592.97
      ],
      "text": "कार्यवाहीस विलंब लागत आहे, त्याउरी मुख्यत: संबंधीत अधिकार्यांची या बाकीतील"
    },
    {
      "id": 25,
      "type": "text",
      "order": 25,
      "poly": [
        35.9,
        596.69,
        477.09,
        596.69,
        477.09,
        613.06,
        35.9,
        613.06
      ],
      "text": "विशिष्टता, त्यांना येणारा या प्रात्यहिक अद्वानी लोगे मुकेच हे कार्य लांबणीवर पडत"
    },
    {
      "id": 26,
      "type": "text",
      "order": 26,
      "poly": [
        35.9,
        616.78,
        477.09,
        616.78,
        477.09,
        633.14,
        35.9,
        633.14
      ],
      "text": "आहे. हंगामी पदे कायम करण्याच्या कामास अधिक विलंब लागू न्ये अशी शासनाची इच्छा"
    },
    {
      "id": 27,
      "type": "text",
      "order": 27,
      "poly": [
        35.9,
        636.86,
        477.09,
        636.86,
        477.09,
        653.23,
        35.9,
        653.23
      ],
      "text": "आहे. संबंधित अधिकार्यांचे या प्रकारकडे त्वरित लहान वेधून व त्यांच्या ही कालुरीकाचे"
    },
