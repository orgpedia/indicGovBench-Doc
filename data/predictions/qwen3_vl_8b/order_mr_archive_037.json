      "poly": [
        79.56,
        318.59,
        550.8,
        318.59,
        550.8,
        339.44,
        79.56,
        339.44
      ],
      "text": "करण्यात येते. यासंबंधीत्या सध्याट्या कार्यप्रदतीमध्ये सुलभीकरण करण्याट्या छूटीने"
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        79.56,
        339.44,
        550.8,
        339.44,
        550.8,
        360.29,
        79.56,
        360.29
      ],
      "text": "भारत सरकारच्या विवर्त मैत्रालयाकडून वर क्रमांक [१] येथे नमुद केलेल्या दिनांक १६. ६. ८६"
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        79.56,
        360.29,
        550.8,
        360.29,
        550.8,
        381.14,
        79.56,
        381.14
      ],
      "text": "च्या कायालिप्तीन जापनान्वये [प्रत तोडत जोडली आहे] सुधारीत सुचना निर्माण करण्यात"
    },
    {
      "id": 13,
      "type": "text",
      "order": 13,
      "poly": [
        79.56,
        381.14,
        548.96,
        381.14,
        548.96,
        401.99,
        79.56,
        401.99
      ],
      "text": "आलेल्या आहेत. या सुधारीत सुचना राज्य शासनानेही स्वकारलेल्या आहेत आणि"
    },
