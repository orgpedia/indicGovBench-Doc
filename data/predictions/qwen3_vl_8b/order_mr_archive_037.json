      "type": "text",
      "order": 16,
      "poly": [
        79.56,
        443.69,
        548.96,
        443.69,
        548.96,
        464.54,
        79.56,
        464.54
      ],
      "text": "खाली सर्वसाधारण: त्याचि नूतन आणि भत्ते, खर्च खाती टाकले जातात आणि बेतन"
    },
    {
      "id": 17,
      "type": "text",
      "order": 17,
      "poly": [
        79.56,
        485.39,
        548.96,
        485.39,
        548.96,
        506.24,
        79.56,
        506.24
      ],
      "text": "लेखाशीषिखाली वर्गिकरण करण्यात यावे. त्याच्युमाणे उत्तर अग्निमाचि दसूली त्याच"
    },
