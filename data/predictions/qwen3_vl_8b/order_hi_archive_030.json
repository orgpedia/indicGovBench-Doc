    {
      "id": 15,
      "type": "text",
      "order": 15,
      "poly": [
        45.81,
        260.18,
        525.98,
        260.18,
        525.98,
        353.64,
        45.81,
        353.64
      ],
      "text": "उपरोक्त विषय में प्रदेश के विभिन्न संमागों में कतिपय देकेदारों के विरुद्ध कार्य प्रारंभ न करने के कारण या धीमी गति से कार्य करने के कारण या अन्य वजह से उनके विरुद्ध अनुबंध की कड़िका 3 \"सी\" के अन्तर्गत कार्यवाही की गई है तथा मूल देकेदार की लागत एवं जोखिम पर शेष कार्य .क्र. निविदा आमंत्रित की गई है जिससे मूल देकेदार के विरुद्ध वसूली उद्दमूत हो गई है जिसे संबंधित जिले के कार्यपालन यंत्री आर.आर.सी. के माध्यम से वसूल करने हेतु कार्यवाही कर रहे हैं।"
    },
    {
      "id": 16,
      "type": "text",
      "order": 16,
      "poly": [
        45.81,
        353.64,
        525.98,
        353.64,
        525.98,
        471.52,
        45.81,
        471.52
      ],
      "text": "इन प्रकरणों में यह तथ्य जानकारी में आया है कि उपरोक्त उल्लेखित तस्सुलियाँ केवल पुस्तकों में दर्ज हैं। व्यवहारिक रूप से वसूलियाँ नहीं हो पा रही हैं इसके कारण शासन के वित्तीय हित प्रभावित हो रहे हैं। ऐसे प्रकरणों की समीक्षा के दौरान यह निर्णय लिया गया है कि समस्त संमागों के कार्यपालन यंत्रियों द्वारा अनुबंध की कड़िका 3 \"सी\" के अन्तर्गत कार्यवाही उपरांत छोड़े गये कार्यों के परिप्रेक्ष्य में वसूली योग्य राशि का विवरण मासिक रिटर्न के रूप में प्रतिमाह अधीक्षण यंत्री को प्रेषित किया जावे जिसकी पूर्वाकित प्रति मुख्य अभियन्ता एवं प्रमुख अभियन्ता को प्रतिमाह की 15 तारीख तक प्रेषित की जावे। जानकारी प्रस्तुत करने के लिए प्रप्त संलग्न है। यह आदेश तत्काल प्रभाव से लागू होंगे।"
    },
