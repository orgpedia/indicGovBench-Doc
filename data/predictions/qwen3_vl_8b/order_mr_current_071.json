        300.59,
        495.63,
        314.07,
        86.87,
        314.07
      ],
      "text": "ग्रामपंचायत हिजवडी ता.मुखरी जि.पुणे यांसकडुन श्री.श्याम हतुमंत बाकडकर यांचे मोजे हिजवडी येथील सह्य"
    },
    {
      "id": 16,
      "type": "text",
      "order": 16,
      "poly": [
        83.3,
        314.07,
        495.63,
        314.07,
        495.63,
        328.38,
        83.3,
        328.38
      ],
      "text": "नं.२६९/२/१३ वारक बांधकाम करण्यात येणार्या राजलक्ष्मी रिजलकॉन रहिवासी प्रकल्पाचे बांधकाम पुर्ण झाले नंतर इमारतीला"
    },
    {
      "id": 17,
      "type": "text",
      "order": 17,
      "poly": [
        83.3,
        328.38,
        368.9,
        328.38,
        368.9,
        342.69,
        83.3,
        342.69
      ],
      "text": "मोजे हिजवडी गावाच्या पाणी पुरवठा योजने दुरे उपलब्धते नुसार पिण्याचे पाणी दिले जाईल."
    },
    {
      "id": 18,
      "type": "text",
      "order": 18,
      "poly": [
        83.3,
        350.27,
        495.63,
        350.27,
        495.63,
        363.74,
        83.3,
        363.74
      ],
      "text": "१. ग्रामपंचायत मुठा नदीकाठी दोन विहीरी आहेत, ज्या मधूत ग्रामपंचायतला ७०० के.एल.डी पाणी पुरवठा होतो. तसेच"
    },
    {
      "id": 19,
      "type": "text",
      "order": 19,
      "poly": [
        83.3,
        363.74,
        495.63,
        363.74,
        495.63,
        378.06,
        83.3,
        378.06
      ],
      "text": "एम.आय.डी.सी कडुन ग्रामपंचायतीला ६०० के.एल.डी पाणी पुरवठा होतो. सदर पाणी पुरवठाबुत ११५० के.एल.डी. पाणी पुरवठा"
    },
    {
      "id": 20,
      "type": "text",
      "order": 20,
      "poly": [
        83.3,
        378.06,
        289.76,
        378.06,
        289.76,
        392.37,
        83.3,
        392.37
      ],
      "text": "ग्रामपंचायतीच्या पाणी फिल्टर केंद्रावरून गावात केला जातो."
    },
    {
      "id": 21,
      "type": "text",
      "order": 21,
      "poly": [
        83.3,
        399.95,
        332.01,
        399.95,
        332.01,
        425.21,
        83.3,
        425.21
      ],
      "text": "२. सन २०११ च्या जनगणनेनुसार हिजवडी गावची लोकसंख्या ११४५९ एवढी आहे."
    },
    {
      "id": 22,
      "type": "text",
      "order": 22,
      "poly": [
        83.3,
        425.21,
        495.63,
        425.21,
        495.63,
        439.52,
        83.3,
        439.52
      ],
      "text": "३. ग्रामपंचायत हदीमध्ये प्रस्तावित वाढ लक्षात घेता, ग्रामपंचायतीनी येणार्या काठात ग्रामपंचायत हदीत साधारण ३ पट लोकसंख्या"
    },
    {
      "id": 23,
      "type": "text",
      "order": 23,
      "poly": [
        83.3,
        439.52,
        425.42,
        439.52,
        425.42,
        453.84,
        83.3,
        453.84
      ],
      "text": "विचारपिन चेकन त्यासाठी पाणीपुरवठा उपलब्ध करून देण्यासाठी खालील पाणीपुरवठा योजना प्रस्तावित आहे."
    },
    {
      "id": 24,
      "type": "text",
      "order": 24,
      "poly": [
        83.3,
        453.84,
        495.63,
        453.84,
        495.63,
        468.15,
        83.3,
        468.15
      ],
      "text": "४. ग्रामपंचायत प्रस्तावित विकसीत क्षेत्रातील प्रकल्पांस पाणी पुरवठासाठी मागीर बाबा पाणी पुरवठा योजना, बाकड पुणे."
    },
    {
      "id": 25,
      "type": "text",
      "order": 25,
      "poly": [
        83.3,
        468.15,
        495.63,
        468.15,
        495.63,
        482.47,
        83.3,
        482.47
      ],
      "text": "वांचकडुन अंदाजे २००० ते ३००० के.एल.डी पाणी घेण्याचा करार दि.३० मार्च २०२१ रोजी झाला असुन त्याची पुढील प्रक्रिया"
    },
    {
      "id": 26,
      "type": "text",
      "order": 26,
      "poly": [
        83.3,
        482.47,
        495.63,
        482.47,
        495.63,
        496.78,
        83.3,
        496.78
      ],
      "text": "सुरू आहे. सदर नियोजनाचा खर्च सुमारे ६० ते ८० लक्ष ग्रामस्थ व लोकवर्गी भारत करण्यात येणार असुन, सदर योजना पुढील"
    },
    {
      "id": 27,
      "type": "text",
      "order": 27,
      "poly": [
        83.3,
        496.78,
        246.92,
        496.78,
        246.92,
        511.09,
        83.3,
        511.09
      ],
      "text": "२ ते ३ वर्षात पुर्ण करण्याचा ग्रामपंचायतीचा मानस आहे."
    },
    {
      "id": 28,
      "type": "text",
      "order": 28,
      "poly": [
        83.3,
        518.67,
        495.63,
        518.67,
        495.63,
        532.99,
        83.3,
        532.99
      ],
      "text": "५. तसेच शासनाच्या जल जीवन योजना/मुखरी प्रादेशिक पाणी पुरवठा योजने अंतर्गत ग्रामपंचायतीला पाणीपुरवठा प्रस्तावित"
    },
    {
      "id": 29,
      "type": "text",
