        259.34
      ],
      "text": "The undersigned is directed to say that with effect from\n18th January, 1993 :-",
      "html": null
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        135.06,
        282.07,
        554.54,
        282.07,
        554.54,
        324.17,
        135.06,
        324.17
      ],
      "text": "1) The Prime Minister relinquished the office of the\n Minister of Civil Supplies, Consumer Affairs and Public\n Distribution, Minister of Commerce and Minister of\n External Affairs.",
      "html": null
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        135.06,
        335.96,
        555.13,
        335.96,
        555.13,
        367.95,
        135.06,
        367.95
      ],
      "text": "2) Shri B. Shankaranand relinquished the office of the\n Minister of Petroleum and Natural Gas and assumed the\n office of the Minister of Health and Family Welfare.",
      "html": null
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        135.06,
        379.74,
        555.13,
        379.74,
        555.13,
        400.79,
        135.06,
        400.79
      ],
      "text": "3) Shri Ghulam Nabi Azad relinquished the office of the\n Minister of Parliamentary Affairs.",
      "html": null
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        135.06,
        411.74,
        554.54,
        411.74,
        554.54,
        442.89,
        135.06,
        442.89
      ],
      "text": "4) Shri A.K. Antony assumed the office of the Minister of\n Civil Supplies, Consumer Affairs and Public\n Distribution.",
      "html": null
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        135.06,
        454.68,
        554.54,
        454.68,
        554.54,
        474.89,
        135.06,
        474.89
      ],
      "text": "5) Shri Dinesh Singh assumed the office of the Minister of\n External Affairs.",
      "html": null
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        135.06,
        486.68,
        554.54,
        486.68,
        554.54,
        517.83,
        135.06,
        517.83
      ],
      "text": "6) Shri Vidyacharan Shukla, Minister of Water Resources\n also assumed the office of the Minister of\n Parliamentary Affairs.",
      "html": null
    },
    {
      "id": 13,
      "type": "text",
      "order": 13,
      "poly": [
        135.06,
        530.46,
        554.54,
        530.46,
        554.54,
        549.83,
        135.06,
        549.83
      ],
      "text": "7) Shri Pranab Mukherjee assumed the office of the\n Minister of Commerce.",
      "html": null
    },
    {
      "id": 14,
      "type": "text",
      "order": 14,
      "poly": [
