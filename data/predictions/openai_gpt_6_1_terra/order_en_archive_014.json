        203.76,
        558.11,
        228.18,
        168.98,
        228.18
      ],
      "text": "1. Shri Uma Shankar Dikshit assumed the office of Minister\n of Works and Housing;",
      "html": null
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        168.38,
        235.76,
        543.83,
        235.76,
        543.83,
        260.18,
        168.38,
        260.18
      ],
      "text": "2. Shri H.N. Bahuguna assumed the office of Minister (of\n State) of Communications;",
      "html": null
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        168.98,
        268.6,
        564.65,
        268.6,
        564.65,
        293.86,
        168.98,
        293.86
      ],
      "text": "3. Prof. D.P. Chattopadhyaya assumed the office of Minister\n of State in the Ministry of Health and Family Planning;",
      "html": null
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        168.98,
        301.44,
        571.2,
        301.44,
        571.2,
        347.75,
        168.98,
        347.75
      ],
      "text": "4. Shri Niti Raj Singh Chaudhury relinquished the office of\n Minister of State in the Ministry of Petroleum, Chemicals\n and Non-Ferrous Metals and assumed the office of Minister\n of State in the Ministry of Law and Justice;",
      "html": null
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        168.38,
        356.17,
        580.72,
        356.17,
        580.72,
        401.63,
        168.38,
        401.63
      ],
      "text": "5. Shri D.R. Chavan relinquished the office of Minister of\n State in the Ministry of Petroleum, Chemicals and Non-\n Ferrous Metals and assumed the office of Minister(of State)\n of Supply;",
      "html": null
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        168.38,
        410.9,
        529.55,
        410.9,
        529.55,
        435.31,
        168.38,
        435.31
      ],
      "text": "6. Shri Mohan Dharia assumed the office of Minister of\n State in the Ministry of Planning;",
      "html": null
    },
    {
      "id": 13,
      "type": "text",
      "order": 13,
      "poly": [
        167.79,
        443.73,
        575.37,
        443.73,
        575.37,
        479.1,
        167.79,
        479.1
      ],
      "text": "7. Shri K.R. Ganesh relinquished the office of Deputy\n Minister in the Ministry of Finance and assumed the office\n of Minister of State in the Ministry of Finance;",
      "html": null
    },
    {
      "id": 14,
      "type": "text",
      "order": 14,
      "poly": [
        167.79,
        487.52,
        562.87,
        487.52,
        562.87,
        532.99,
        167.79,
        532.99
      ],
      "text": "8. Shri I.K. Gujral relinquished the office of Minister of\n Works, Housing and Urban Development and assumed the\n office of Minister of State in the Ministry of Works and\n Housing;",
      "html": null
    },
    {
      "id": 15,
      "type": "text",
      "order": 15,
      "poly": [
        166.01,
