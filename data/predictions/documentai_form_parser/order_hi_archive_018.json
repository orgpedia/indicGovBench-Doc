        310.3,
        176.4,
        206.5,
        176.4
      ],
      "text": "नागिन्दर सिंह,\nप्रमुख सचिव,\nउत्तर प्रदेश शासन ।"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        140.1,
        184.7,
        182.4,
        184.7,
        182.4,
        199.7,
        140.1,
        199.7
      ],
      "text": "सेवा मैं,"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        205.1,
        208.3,
        433.2,
        209.4,
        432.9,
        267.5,
        204.7,
        266.4
      ],
      "text": "समस्त मण्डला पुर्वेत,\nसमस्त विभागाध्यत्र एवं प्रमुख कार्यालयाध्यक्ष,\nउत्तर प्रदेश ।"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        349.0,
        270.4,
        545.7,
        270.7,
        545.7,
        291.9,
        349.0,
        291.5
      ],
      "text": "लखनऊः दिनांकः 14 नवम्बर, 1994"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        33.5,
        275.4,
        174.3,
        276.1,
        174.3,
        293.0,
        33.5,
        292.3
      ],
      "text": "प्रशासनिक सुधार अनुभाग-।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        139.4,
        298.7,
        335.4,
        299.1,
        335.4,
        315.6,
        139.4,
        315.2
      ],
      "text": "विषयः - अभिलेखों का निर्दान।"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        133.8,
        327.8,
        179.6,
        327.8,
        179.6,
        346.4,
        133.8,
        346.4
      ],
      "text": "मुझेदय,"
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        133.5,
        353.9,
        556.6,
        354.3,
        556.2,
        539.3,
        133.1,
        539.0
      ],
      "text": "राजकीय कायालयों में उपलब्ध अभिलेखों की प्रकृति तथा भविष्य में\nउनकी आवश्यकता एवं उपयोगिता को ध्यान में रखते हुए अभिलेखों के निर्दान\nके संबंध में सम्यक विचारोपरान्त प्रशासनिक सुधार अनुभाग - । के शासनादेश तं०\n3339/43-1-92-37111/84, दिनांक 30 जनवरी, 1993 1 प्रतिलिपि संलग्न ।\nद्वारा यह अनुरोध किया गया था कि जिन कार्यालयों में निर्मान नियम विद्यमान\nन हों अथवा जिनमें ये नियम आलेख रूप में हों वे अपने निर्दान नियमों को अंतिम\nरूप देने के लिए उक्त उल्लिखित शासनादेश दिनांक 30 जनवरी, 1993 से संलग्न\nसूची की सहायता से अद्यावधिक बना लें।"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        125.1,
        548.3,
        558.7,
        548.7,
        558.7,
        711.1,
        125.1,
        710.8
      ],
      "text": "प्रशासनिक सुधार विभाग के नियंत्रणाधीन कार्यरत राजकीय कार्यालय\n✓ निरीक्षणालय, उत्तर प्रदेश, इलाहाबाद के माध्यम से विभिन्न राजकीय कार्यालयों\nमैं कराये गये अध्ययन के दौरान यह पाया गया है कि अधिकांशतः कार्यालयों में\nपुराने अभिलेखों की \"बी डिंग\" का कार्य उपेक्षित दभा में रहता है। इतते न केवल\nपुराने अनुपयोगी अभिलेखों को रखने के लिए अनावश्यक फर्नीचर क्रय करना पड़ता\nहै और व्यय भार बढ़ता है बल्कि कार्यालयों में कर्मचारियों के बैठने के स्थान व\nसफाई देई जा समुचित व्यवस्था भी सुनिश्चित नहीं हो पाती ।"
    },
