    {
      "id": 16,
      "type": "text",
      "order": 16,
      "poly": [
        52.0,
        559.6,
        483.5,
        561.3,
        483.5,
        601.0,
        52.0,
        599.2
      ],
      "text": "मेरी जानकारी और विश्वास के साथ दिया गया ब्यौस सही है। यदि उपर्युक्त ब्यौरा गलत या अपथार्थ पाया जाय,\nतो मैं वैयक्तिक वेतन प्राप्त करने पर उसे लौटा देने का वचन देता हूं। मुझे यह भी मालूम है कि तथ्यों का अययार्थ\nविदरण देकर वैयक्तिक, बेतंत प्राप्त करने का प्रयत्न करने के लिए मेरे विरुद्ध अनुशासनिक कार्रवाई की जा सकती है।"
    },
