      "poly": [
        99.8,
        490.4,
        503.3,
        490.4,
        503.3,
        505.6,
        99.8,
        505.6
      ],
      "text": "इच्छुक उम्मीदवार सम्पूर्ण सूचना एवं ब्यौरों के लिए केन्द्रीय सतर्कता आयोग अधिनियम, 2003 देखें।"
    },
    {
      "id": 17,
      "type": "text",
      "order": 17,
      "poly": [
        99.8,
        521.6,
        216.3,
        521.6,
        216.3,
        535.4,
        99.8,
        535.4
      ],
      "text": "पात्रता एवं अन्य अपेक्षाएं :-"
    },
    {
      "id": 18,
      "type": "text",
      "order": 18,
      "poly": [
        63.0,
        525.8,
