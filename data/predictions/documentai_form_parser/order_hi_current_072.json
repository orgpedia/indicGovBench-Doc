      ],
      "text": "विषय : केन्द्रीय सतर्कता आयोग में केन्द्रीय सतर्कता आयुक्त के पद हेतु चयन।"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        62.7,
        211.0,
        553.2,
        211.0,
        553.2,
        275.8,
        62.7,
        275.8
      ],
      "text": "भारत सरकार ने केन्द्रीय सतर्कता आयोग अधिनियम, 2003 (अधिनियम) के अंतर्गत प्रदत्त शक्तियों का प्रयोग\nकरने तथा सौंपे गए कार्यों का निष्पादन करने हेतु केन्द्रीय सतर्कता आयोग (सीवीसी) का गठन किया है । सीवीसी का\nकार्यालय नई दिल्ली में स्थित है। इस आयोग में एक केन्द्रीय सतर्कता आयुक्त तथा अधिकतम दो सतर्कता आयुक्त होते\nहैं। केन्द्रीय सतर्कता आयोग के कार्य एवं शक्तियां इस अधिनियम के अध्याय 3 के प्रावधानों के अनुसार हैं।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        63.7,
        302.0,
        553.2,
        302.0,
        553.2,
        333.2,
        63.7,
        333.2
      ],
      "text": "केंद्रीय सतर्कता आयोग में केंद्रीय सतर्कता आयुक्त की नियुक्ति का प्रस्ताव है, जो वर्तमान केंद्रीय सतर्कता\nआयुक्त का कार्यकाल समाप्त होने पर 3 अगस्त, 2026 से रिक्त हो जाएगी।"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        62.7,
        305.9,
        71.1,
        305.9,
        71.1,
        313.7,
        62.7,
        313.7
      ],
      "text": "2."
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        62.7,
        348.8,
        71.5,
        348.8,
        71.5,
        357.3,
        62.7,
        357.3
      ],
      "text": "3."
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        64.1,
        345.6,
        551.8,
        345.6,
        551.8,
        376.7,
        64.1,
        376.7
      ],
      "text": "केन्द्रीय सतर्कता आयुक्त अपने पद पर अपनी तैनाती की तारीख से चार वर्षों की अवधि के लिए अथवा उनके\n65 वर्ष की आयु प्राप्त होने, जो भी पहले हो, तक इस पद पर रहेंगे/रहेंगी।"
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        98.8,
        392.7,
        512.2,
        392.7,
        512.2,
        407.5,
        98.8,
        407.5
      ],
      "text": "केन्द्रीय सतर्कता आयुक्त, कार्यालय से पदमुक्त होने पर, आयोग में पुनर्नियुक्ति के लिए पात्र नहीं होंगे ।"
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        61.6,
        396.6,
        71.9,
        396.6,
        71.9,
        404.4,
        61.6,
        404.4
      ],
      "text": "4."
    },
    {
      "id": 13,
      "type": "text",
      "order": 13,
      "poly": [
        63.4,
        429.9,
        71.5,
        429.9,
        71.5,
        438.3,
        63.4,
        438.3
      ],
      "text": "5."
    },
    {
      "id": 14,
      "type": "text",
      "order": 14,
      "poly": [
        63.4,
        426.3,
        552.9,
        426.3,
        552.9,
        474.5,
        63.4,
        474.5
      ],
      "text": "केन्द्रीय सतर्कता आयुक्त को देय वेतन एवं भत्ते तथा अन्य सेवा संबंधी शर्तें संघ लोक सेवा आयोग के अध्यक्ष को\nदेय वेतन एवं भत्तों तथा सेवा शर्तों समान होंगी जो इस अधिनियम के प्रावधानों के अनुसार उनके द्वारा लिए गए पेंशन/\nसेवा निवृत्ति संबंधी लाभों, यदि कोई हो, को समायोजित करने के अध्यधीन होंगी।"
    },
