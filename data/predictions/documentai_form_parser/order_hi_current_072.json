      "id": 15,
      "type": "text",
      "order": 15,
      "poly": [
        63.0,
        494.6,
        72.2,
        494.6,
        72.2,
        502.8,
        63.0,
        502.8
      ],
      "text": "6."
    },
    {
      "id": 16,
      "type": "text",
