      ],
      "text": "कनिष्ठ न्यायालय व उच्च\nन्यायालयातील विधी\nअधिकारी व पॅनेल समुपदेशींना\nसध्या विहित नियमांतील\nमर्यादपलीकडीत फी मंजूर\nकरण्याचे प्राधिकार रु. १५००८-\nप्रतिदिन ह्या वित्तीय\nमय दिपर्यंत."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        376.7,
        181.1,
        441.0,
        181.6,
        441.0,
        393.9,
        376.6,
        393.4
      ],
      "text": "अर्थसंकल्पान तरतूद\nकेलेली असली पाहिजे.\nआख्न दिलेल्या\nकार्यपध्दतीचे व सर्व-\nसाधारण निर्देशाचे/\nअटींचे पालन केले\nपाहिजे."
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        34.1,
        194.5,
        149.7,
        189.7,
        150.1,
        286.4,
        34.6,
        291.3
      ],
      "text": "विधी अधिकारी अथवा पॅनेल समुपदेशी\nयांना महाविधी अधिकारी [नियुक्ती\nसेवाशर्ती व शुल्क] नियम १९८४ व"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        165.6,
        185.9,
        260.8,
        183.8,
        261.0,
        248.8,
        165.6,
        251.0
      ],
      "text": "सचिव, विधी व न्याय विभाग\nआणि विधी परामर्मी.."
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        18.1,
