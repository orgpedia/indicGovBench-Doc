      "type": "text",
      "order": 3,
      "poly": [
        124.8,
        123.1,
        426.2,
        122.8,
        426.2,
        158.4,
        124.8,
        158.6
      ],
      "text": "निर्णय क्रमांकः एडीव्ही-११८८/प्र.क्र. ३५/कोषागार-६,\nमंत्रालय, मुंबई-४०० ०३२, दिनांक ३० मार्च, १९८८."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        229.0,
        159.4,
        297.4,
        159.1,
        297.4,
        173.8,
        229.0,
        174.1
      ],
      "text": "निर्णय"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        28.4,
        176.5,
        539.2,
        175.8,
        539.2,
        246.6,
        28.4,
        247.4
      ],
      "text": "मोटारगाडी शिवाय अन्य वाहन खरेदीसाठी म्हणजेच मोटार सायकल, स्कूटर, मोपेड किंवा\nदुचाकी खरेदी करण्यासाठी सरकारी कर्मचा-यांना, दिनांक १ एप्रिल, १९८७ ते ३१ मार्च,\n१९८८ या कालावधीत देण्यात आलेल्या अग्रिमावर शासनाने व्याजाचा दर प्रतिवर्षी\n८ टक्के [आठ टक्के] असा निश्चित केला आहे."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        154.2,
        255.0,
        464.4,
        254.5,
        464.4,
        270.9,
        154.2,
        271.4
      ],
      "text": "महाराष्ट्राचे राज्यपाल यांच्या आदेशानुसार व नावाने,"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        354.6,
        273.1,
        463.9,
        273.1,
        463.9,
        317.0,
        354.6,
        317.0
      ],
      "text": "दि. दै. पत्की,\nकार्यासन अधिकारी,\nवित्त विभाग."
    },
