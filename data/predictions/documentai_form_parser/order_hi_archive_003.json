      ],
      "text": "83. दा० ज्ञा० सं० 12014/2/76-रा० भा० (डी), दिनांक 2-9-76"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        45.0,
        238.2,
        534.1,
        242.1,
        533.8,
        277.8,
        44.6,
        273.9
      ],
      "text": "विषय :- हिन्दी, हिन्दी टाइपिंग और हिन्दी आशुलिपि की परीक्षाएं पास करने पर प्रोत्साहन - वैयक्तिक वेतन संबंधी आदेशों\nका समेकित किया जाना ।\n:"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        41.4,
        277.8,
        531.6,
        284.2,
        530.9,
        344.0,
        40.7,
        337.6
      ],
      "text": "उपर्युक्त विषय पर, अबतक जारी किए गए आदेशों का अधिक्रमण करते हुए मुझे निम्नलिखितः शतौ पर हिन्दी\nशिक्षण योजना के अन्तर्गत ली जाने वाली हिन्दी, हिन्दी टाइपिंग और हिन्दी था‌लिपि की परीक्षायों को पास करने पर,\nकेन्द्रीय सरकार के कर्मचारियों को 12 महीने की अवधि के लिए एक वेतनवृद्धि के बराबर राति का वैयक्तिक वेतन देने\nके लिए राष्ट्रपति द्वारा दी गई मंजूरी की सूचना देने का निर्देश हुआा है:"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        39.3,
        340.8,
        528.8,
        345.8,
        528.5,
        377.3,
        38.9,
        372.3
      ],
      "text": "(1) प्राज्ञ परीक्षा वैयक्तिक वेतन केवल उन्हीं सरकारी कर्मचारियों को दिया जाएगा, जिनके लिए, प्राज्ञ पाठ्यक्रम\nअंतिम पाठ्यक्रम के रूप में निर्धारित किया गया है:"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        95.2,
        375.9,
        408.8,
        380.1,
        408.5,
        395.3,
        94.9,
        391.1
      ],
      "text": "(क) अराजपत्रित कर्मचारियों को, प्रान्त परीक्षा में पास अंक प्राप्त करने पर;"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        94.5,
        394.6,
        495.2,
        400.6,
        494.8,
        415.5,
        94.2,
        409.5
      ],
      "text": "(ख) राजपत्रित कर्मचारियों को 60 प्रतिशत या अधिक अंक लेकर प्राज्ञ परीक्षा पास करने पर ।"
    },
