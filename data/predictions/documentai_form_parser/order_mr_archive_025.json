      "poly": [
        42.0,
        374.7,
        293.8,
        374.7,
        293.8,
        407.9,
        42.0,
        407.9
      ],
      "text": "महालेखापाल, महाराष्ट्र १, मुंबई, (१६० प्रती),\nमहालेखापाल, महाराष्ट्र २, नागपूर, (४० प्रती),"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        41.0,
        409.5,
        281.4,
        409.9,
        281.4,
        462.7,
        41.0,
        462.4
      ],
      "text": "अधिदान व लेना अधिकारी, मुंबई,\nनिवासी लेखा परीक्षा अधिकारी, मुंबई,\nमुख्य लेखा परीक्षक, स्थानिक निधी लेखा, मुंबई,"
    },
