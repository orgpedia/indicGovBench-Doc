      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        42.0,
        481.8,
        140.5,
        481.8,
        140.5,
        497.5,
        42.0,
        497.5
      ],
      "text": "मुख्य मंत्र यांचे सचिव,"
