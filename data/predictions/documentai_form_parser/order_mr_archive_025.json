      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        45.3,
        464.0,
        136.3,
        464.0,
        136.3,
        478.5,
        45.3,
        478.5
      ],
      "text": "राज् यपालांचे सचिव,"
