      ],
      "text": "पाटबंधारे आणि इतर भांडवली अर्च\nयांवरील व्याज दर व त्याचे समायोजन."
    },
    {
      "id": 1,
      "type": "text",
      "order": 1,
      "poly": [
        200.3,
        72.6,
        278.4,
        72.6,
        278.4,
        102.1,
        200.3,
        102.1
      ],
      "text": "महाराष्ट्र शासन\nवित्त विभाग,"
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        118.9,
        105.1,
        435.4,
        105.1,
        435.4,
        140.2,
        118.9,
        140.2
      ],
      "text": "नासब निर्णय क्रमांक आयआरआय-१०७९/६२६/६२४/जीईएन-५,\nमोहालय, मुंबई ४०० ०३२, दिनांक २ ऑक्टोबर १९७९."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        199.6,
        154.7,
        260.7,
        154.7,
        260.7,
        168.5,
        199.6,
        168.5
      ],
