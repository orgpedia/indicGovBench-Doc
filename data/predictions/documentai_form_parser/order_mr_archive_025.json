      "type": "text",
      "order": 5,
      "poly": [
        28.2,
        189.5,
        502.0,
        189.5,
        502.0,
        254.8,
        28.2,
        254.8
      ],
      "text": "ज्या कामांचा, मुंबई विकास योजनेसह, गांडवली लेखा ठेवण्यात येतो अशा मांडवली अर्चावरील\n१९७९-८० या वर्षाकरिता व्याजाचे समायोजन करण्यासाठी सरासरी व्याजाचा दर ७ टक्के असा\nशासनाने ठरविला आहे. (या शासन निर्णयाचा इंगजी अनुवाद सोबत जोडण्यात आला आहे.)"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        128.4,
        280.5,
        386.8,
        280.5,
        386.8,
        297.2,
        128.4,
        297.2
      ],
      "text": "महाराष्ट्राचे राज्यपाल यांच्या आदेशानुसार व नावाने,"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        275.1,
        320.2,
        410.7,
        320.2,
        410.7,
        348.4,
        275.1,
        348.4
      ],
      "text": "व. स. धारूरकर,\nअवर सचिव, वित्त विभाग."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        23.6,
        352.1,
        46.0,
        352.1,
        46.0,
        364.5,
        23.6,
        364.5
      ],
      "text": "प्रति"
    },
