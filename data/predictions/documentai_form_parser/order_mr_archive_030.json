      "type": "text",
      "order": 24,
      "poly": [
        37.2,
        253.7,
        123.8,
        253.1,
        123.8,
        265.0,
        37.2,
        265.7
      ],
      "text": "सव कोषागार अधिकारी;"
    },
    {
