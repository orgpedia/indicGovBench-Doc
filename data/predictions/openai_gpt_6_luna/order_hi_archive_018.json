        145.18,
        175.98
      ],
      "text": "प्रेषक,\nनागेन्द्र सिंह,\nप्रमुख सचिव,\nउत्तर प्रदेश शासन ।"
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        141.01,
        185.24,
        431.38,
        185.24,
        431.38,
        265.23,
        141.01,
        265.23
      ],
      "text": "सेवा में,\nसमस्त मण्डलायुक्तों,\nसमस्त विभागाध्यक्षों एवं प्रमुख कार्यालयाध्यक्ष,\nउत्तर प्रदेश ।"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        349.26,
        271.12,
        546.21,
        271.12,
