      ],
      "text": "मोटारगाडीशिवाय अन्य वाहनांची खरेदी करण्यासाठी\nदिलेला आगाऊ-या आगाऊवर आकारण्यात येणाऱ्या व्याजाच्या\nदरांबाबत."
    },
    {
      "id": 1,
      "type": "text",
      "order": 1,
      "poly": [
        212.75,
        90.71,
        313.95,
        90.71,
        313.95,
        121.64,
        212.75,
        121.64
      ],
      "text": "महाराष्ट्र शासन\nवित्त विभाग,"
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        124.2,
        125.4,
        424.93,
        125.4,
        424.93,
        162.18,
        124.2,
        162.18
      ],
      "text": "निर्णय क्रमांक: एडीबीटी-१९८८/प्र.क्र. ३५/कोषागार-६,\nमंत्रालय, मुंबई-४०० ०३२, दिनांक ३० मार्च, १९८८."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        228.28,
        161.35,
        297.85,
        161.35,
        297.85,
        175.56,
        228.28,
        175.56
      ],
      "text": "विषय"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        28.18,
        178.9,
        538.2,
        178.9,
        538.2,
        253.31,
        28.18,
        253.31
      ],
      "text": "मोटारगाडीशिवाय अन्य वाहन खरेदी म्हणजेच मोटार-सायकल, स्कूटर, मोपेड इत्यादी\nदुचाकी खरेदी करण्यासाठी सरकारी कर्मचा-यांना, दिनांक १ एप्रिल, १९८७ ते ३१ मार्च,\n१९८८ या कालावधीत देण्यात आलेल्या आगाऊवर शासनाने व्याजाचा दर प्रतिवर्षी\n८ टक्के [आठ टक्के] असा निश्चित केला आहे."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        154.68,
        255.82,
        464.03,
        255.82,
        464.03,
        274.63,
        154.68,
        274.63
      ],
      "text": "महाराष्ट्राचे राज्यपाल यांच्या आदेशानुसार व नांवाने,"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        354.77,
        275.46,
        462.88,
        275.46,
        462.88,
        325.62,
        354.77,
        325.62
      ],
      "text": "दि. ह. पंतकी,\nकार्यासन अधिकारी,\nवित्त विभाग."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        28.18,
        313.92,
        378.35,
        313.92,
        378.35,
        385.81,
        28.18,
        385.81
      ],
      "text": "प्रति,\nमहालेखापाल, [लेखा व अनुज्ञेयता]-१, मुंबई, [६० प्रती],\nमहालेखापाल, [लेखा परीक्षा]-१, मुंबई, [६० प्रती],\nमहालेखापाल, [लेखा व अनुज्ञेयता]-२, नागपूर, [४० प्रती],\nमहालेखापाल, [लेखा परीक्षा]-२, नागपूर, [४० प्रती],"
    },
    {
