      "poly": [
        309.4,
        580.14,
        454.58,
        580.14,
        454.58,
        615.5,
        309.4,
        615.5
      ],
      "text": "(राजेश ह. पाध्ये)\nअवर सचिव, महाराष्ट्र शासन"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        58.91,
        618.87,
