      ],
      "text": "आर० एस० सक्सेना,\nविशेष सचिव,\nउत्तर प्रदेश शासन।"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        79.14,
        214.71,
        111.86,
        214.71,
        111.86,
        230.71,
        79.14,
        230.71
      ],
      "text": "सेवा में"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        118.41,
        233.23,
        276.08,
        233.23,
        276.08,
        267.76,
        118.41,
        267.76
      ],
      "text": "समस्त मण्डलायुक्त,\nसमस्त जिलाधिकारी एवं मुख्य कार्यपालक अधिकारी,\nउत्तर प्रदेश।"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        41.65,
        268.6,
        332.01,
        268.6,
        332.01,
        285.44,
        41.65,
        285.44
      ],
      "text": "प्रशासनिक सुधार अनुभाग-1 लखनऊ: दिनांक 08 जनवरी, 2002"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        80.92,
        289.65,
        200.52,
        289.65,
        200.52,
        305.65,
        80.92,
        305.65
      ],
      "text": "विषय: अभिलेखों का निस्तारण।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        80.92,
        314.07,
        114.84,
        314.07,
        114.84,
        327.54,
        80.92,
        327.54
      ],
      "text": "महोदय,"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        80.33,
        322.49,
        366.52,
        322.49,
        366.52,
        398.27,
        80.33,
        398.27
      ],
      "text": "राजकीय कार्यालयों में उपलब्ध अभिलेखों की प्रकृति तथा भविष्य में\nउनकी आवश्यकता एवं उपयोगिता को ध्यान में रखते हुए अभिलेखों के निस्तारण\nके सम्बन्ध में प्रशासनिक सुधार विभाग के शासनादेश संख्या-1512/43-1-99-\n37111/84, दिनांक 4 अगस्त, 1999 तथा संख्या-229/तीन-नि०-1-2000-37\n111/84, दिनांक 16 अक्टूबर, 2000 का संदर्भ लें।"
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        80.33,
        404.16,
        376.63,
        404.16,
        376.63,
        511.94,
        80.33,
        511.94
      ],
      "text": "2- प्रशासनिक सुधार विभाग के नियंत्रणाधीन कार्यरत राजकीय प्रशासनिक\nनिरीक्षणालय, उत्तर प्रदेश, इलाहाबाद के माध्यम से विभिन्न राजकीय कार्यालयों\nमें कराये गये अध्ययन के दौरान यह पाया गया है कि अधिकांशतः कार्यालयों\nमें पुराने अभिलेखों की ‘वीडिंग’ का कार्य उपेक्षित ढंग से रहता है। इसके\nबिना पुराने महत्वपूर्ण अभिलेखों को रखने के लिए आवश्यक फर्नीचर क्रय करना\nपड़ता है और व्यय भार बढ़ता है बल्कि आवश्यकता के समय रिकार्ड ढूंढने में\nकठिनाई व समय की समुचित व्यवस्था भी सुनिश्चित नहीं हो पाती है।"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        81.52,
        516.15,
        370.69,
        516.15,
        370.69,
        575.93,
        81.52,
        575.93
      ],
      "text": "अतः इस सम्बन्ध में मुझे यह कहने का निदेश हुआ है कि अपने\nअधीनस्थ कार्यालयों में पुराने अभिलेखों की नियमानुसार ‘वीडिंग’ का कार्य\nएक अभियान के रूप में प्राथमिकता के आधार पर, प्रत्येक माह में एक सप्ताह\nमें अवश्य कराने का कष्ट करें।"
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        297.5,
        572.56,
        370.09,
        572.56,
        370.09,
        628.97,
        297.5,
        628.97
      ],
      "text": "भवदीय\n\nआर० एस० सक्सेना।\nविशेष सचिव।"
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        81.52,
        628.13,
        358.78,
        628.13,
        358.78,
        669.39,
        81.52,
        669.39
      ],
      "text": "संख्या: 51/111/43-1-2002, तद्दिनांक।\nप्रतिलिपि सूचनार्थ एवं आवश्यक कार्यवाही हेतु उत्तर प्रदेश के समस्त\nकार्यालयाध्यक्षों को प्रेषित।"
    },
