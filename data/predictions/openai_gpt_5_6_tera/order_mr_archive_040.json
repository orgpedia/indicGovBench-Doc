      ],
      "text": "मोटारगाडी शिवाय अन्य वाहने खरेदी करण्यासाठी\nदिलेल्या अग्रिमावर आकारावयाच्या व्याजाच्या\nदराविषयी."
    },
    {
      "id": 1,
      "type": "text",
      "order": 1,
      "poly": [
        124.78,
        90.29,
        426.65,
        90.29,
        426.65,
        158.0,
        124.78,
        158.0
      ],
      "text": "महाराष्ट्र शासन\nवित्त विभाग,\nनिर्णय क्रमांक: एडीव्ही-१९८८/प्र.क्र.३४/कोषागार-६,\nमंत्रालय, मुंबई-४०० ०३२, दिनांक ३० मार्च, १९८८."
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        228.28,
        161.35,
        296.12,
        161.35,
        296.12,
        175.98,
        228.28,
        175.98
      ],
      "text": "वि ष य"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        28.18,
        175.98,
        530.73,
        175.98,
        530.73,
        249.55,
        28.18,
        249.55
      ],
      "text": "मोटारगाडी शिवाय अन्य वाहन खरेदीसाठी म्हणजेच मोटार-सायकल, स्कूटर, मोपेड किंवा\nदुचाकी खरेदी करण्यासाठी सरकारी कर्मचा-यांना, दिनांक १ एप्रिल, १९८७ ते ३१ मार्च,\n१९८८ या कालावधीत देण्यात आलेल्या अग्रिमावर शासनाने व्याजाचा दर प्रतिवर्षी\n८ टक्के [आठ टक्के] असा निश्चित केला आहे."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        153.53,
        255.82,
        464.6,
        255.82,
        464.6,
        271.28,
        153.53,
        271.28
      ],
      "text": "महाराष्ट्राचे राज्यपाल यांच्या आदेशानुसार व नावाने,"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        354.77,
        273.37,
        469.2,
        273.37,
        469.2,
        319.35,
        354.77,
        319.35
      ],
      "text": "दि. हं. पळकी,\nकार्यासन अधिकारी,\nवित्त विभाग."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        28.18,
        312.25,
        379.5,
        312.25,
        379.5,
        377.45,
        28.18,
        377.45
      ],
      "text": "प्रति,\nमहालेखापाल, [लेखा व अनुज्ञेयता]-१, मुंबई, [८० प्रती],\nमहालेखापाल, [लेखा परीक्षा]-१, मुंबई, [८० प्रती],\nमहालेखापाल, [लेखा व अनुज्ञेयता]-२, नागपूर, [४० प्रती],\nमहालेखापाल, [लेखा परीक्षा]-२, नागपूर, [४० प्रती],"
    },
    {
