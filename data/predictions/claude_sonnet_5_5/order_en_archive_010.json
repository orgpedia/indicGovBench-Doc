      "text": "No.245/C.F/48.\nGOVERNMENT OF INDIA.\nCABINET SECRETARIAT.\nNew Delhi, the 6th December, 1948."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        245.73,
        166.72,
        346.88,
        166.72,
        346.88,
        180.19,
        245.73,
        180.19
      ],
      "text": "OFFICE MEMORANDUM."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        141.61,
        194.5,
        525.38,
        194.5,
        525.38,
        245.02,
        141.61,
        245.02
      ],
      "text": "The undersigned is directed to circulate for the information\nof all Ministries of the Government of India a copy of the minutes\nrecorded by the Prime Minister relating to -"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        166.01,
        260.18,
        483.73,
        260.18,
        483.73,
        300.59,
        166.01,
        300.59
      ],
      "text": "(1) The appointment of Shri R.R.Diwakar, Member of the\nConstituent Assembly, as Minister of State for\nInformation and Broadcasting with effect from the\n7th December, 1948."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        166.01,
        306.49,
        533.12,
        306.49,
        533.12,
        348.59,
        166.01,
        348.59
      ],
      "text": "(2) The appointment of Dr.Balkrishan V.Keskar, Member of the\nConstituent Assembly, as Deputy Minister with effect\nfrom the 7th December, 1948. He will be attached to\nthe Ministry of External Affairs & Commonwealth Relations."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        295.71,
        380.58,
        428.4,
        380.58,
        428.4,
        426.89,
        295.71,
        426.89
      ],
      "text": "(E.C.Donoghue)\nfor Joint Secretary to the Cabinet."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        145.78,
        441.21,
        157.68,
        441.21,
        157.68,
        451.31,
        145.78,
        451.31
      ],
      "text": "To"
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        192.78,
        459.73,
        440.89,
        459.73,
        440.89,
        470.68,
        192.78,
        470.68
      ],
      "text": "All Secretaries to the Government of India."
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        145.78,
        511.94,
        537.28,
        511.94,
        537.28,
        543.93,
        145.78,
        543.93
      ],
      "text": "Copy with a copy of the enclosures forwarded to the\nSecretary and Military Secretary to the Governor-General/the\nPrincipal Private Secretary to the Prime Minister, for information."
