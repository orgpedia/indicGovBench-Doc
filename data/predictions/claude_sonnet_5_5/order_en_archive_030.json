      "text": "Subject:- Swearing-in ceremony -"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        156.49,
        262.7,
        514.67,
        262.7,
        514.67,
        322.49,
        156.49,
        322.49
      ],
      "text": "The undersigned is directed to say that the\nCouncil of Ministers as shown in Annexure 'A' have\nrelinquished their respective offices with effect from\nthe forenoon of 14th January, 1980."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        156.49,
        327.54,
        520.62,
        327.54,
        520.62,
        400.79,
        156.49,
        400.79
      ],
      "text": "2. Smt. Indira Gandhi has been sworn-in as the\nPrime Minister by the President at 10-45 A.M. today,\n14th January, 1980, in the Rashtrapati Bhavan. Other\nMinisters sworn-in by the President at 10-45 A.M. today,\n14th January, 1980 are shown at Annexure 'B'."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        151.72,
        405.84,
        486.71,
        405.84,
        486.71,
        457.21,
        151.72,
        457.21
      ],
      "text": "3. Ministry of Home Affairs may kindly take\nsuch action as may be considered necessary regarding\nissue of Gazette Notifications, etc."
    },
