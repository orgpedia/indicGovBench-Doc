      "poly": [
        83.3,
        199.55,
        564.06,
        199.55,
        564.06,
        290.49,
        83.3,
        290.49
      ],
      "text": "विदित है कि शासन द्वारा समस्त शासकीय कार्यालयों में मंगल फॉन्ट पर पत्राचार किये जाने हेतु निर्देश निर्गत किये गये हैं, जिसका अनुपालन शासन स्तर से जारी पत्रों में स्पष्ट रूप से परिलक्षित होता है, परन्तु शासन द्वारा दिये गये निर्देशों के उपरान्त भी यह देखा जा रहा है कि मुख्यालय तथा क्षेत्रीय, वृतीय एवं खण्डीय कार्यालयों में शासकीय पत्राचार मंगल फॉन्ट पर नहीं किया जा रहा है, जो उचित नहीं है।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        83.3,
        303.96,
        564.06,
        303.96,
        564.06,
        357.85,
        83.3,
        357.85
      ],
      "text": "अतः इस सम्बन्ध में एतद्द्वारा निर्देश दिये जाते हैं कि शासन द्वारा दिये गये निर्देशानुसार मुख्यालय एवं क्षेत्रीय, वृतीय एवं खण्डीय कार्यालयों में समस्त शासकीय पत्राचार मंगल फॉन्ट पर ही कराया जाना सुनिश्चित करें।"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        83.3,
        367.95,
        564.06,
        367.95,
        564.06,
        407.53,
        83.3,
        407.53
      ],
      "text": "उपरोक्त के सम्बन्ध में उच्चस्तर के अधिकारी भी गम्भीरतापूर्वक परिशीलन करते हुए अनुपालन सुनिश्चित करायेंगे।"
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        83.3,
        417.63,
        564.06,
        417.63,
        564.06,
        479.94,
        83.3,
        479.94
      ],
      "text": "कृपया भविष्य के लिए यह भी अंकित कर लिया जाए कि यदि मुख्यालय तथा क्षेत्रीय, वृतीय एवं खण्डीय कार्यालयों द्वारा शासन स्तर पर समन्वय के अभाव में अथवा अन्य शिथिलता के कारण कोई विषम परिस्थिति उत्पन्न होती है तथा सूचना प्रेषित करने में विलम्ब होता है, तो यह स्वीकार्य नहीं होगा एवं कृत्य की गम्भीरता के अनुरूप कार्यवाही अपरिहार्य होगी।"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        151.72,
        488.36,
        423.64,
        488.36,
        423.64,
        511.94,
        151.72,
        511.94
      ],
      "text": "उक्त आदेशों का कड़ाई से अनुपालन सुनिश्चित किया जाए।"
    },
