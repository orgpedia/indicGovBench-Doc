      "id": 19,
      "type": "text",
      "order": 19,
      "poly": [
        75.56,
        487.52,
        184.45,
        487.52,
        184.45,
        500.15,
        75.56,
        500.15
      ],
      "text": "2. मॉनिटरिंग एवं प्रतिवेदन"
