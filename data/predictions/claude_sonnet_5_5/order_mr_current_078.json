      ],
      "text": "सूचना"
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        139.12,
        282.25,
        930.47,
        282.25,
        930.47,
        397.12,
        139.12,
        397.12
      ],
      "text": "राष्ट्रीय आरोग्य अभियान अंतर्गत १० वर्ष व त्यापेक्षा अधिक सेवा पूर्ण केलेल्या\nपात्र कंत्राटी कर्मचाऱ्यांच्या सेवा समायोजनाची कार्यवाही शासनाने निश्चित केलेल्या\nकालबध्द वेळापत्रकानुसार पूर्ण करावयाच्या सुचना या कार्यालयास प्राप्त आहेत."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        139.12,
        418.45,
        930.47,
        418.45,
        930.47,
        531.68,
        139.12,
        531.68
      ],
      "text": "त्यानुसार या कार्यालयाद्वारे पात्र उमेदवारांचे मुळ दस्ताऐवज तपासणी करुन यादी\nतयार केलेली आहे. सदर यादी राज्यस्तरावरुन प्राप्त सुचनेनुसार आक्षेपाकरीता\nकार्यालयाच्या संकेतस्थळावर प्रकाशीत करण्यात येत आहे."
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        139.12,
        551.38,
        930.47,
        551.38,
        930.47,
        776.19,
        139.12,
        776.19
      ],
      "text": "करीता प्रकाशीत यादीवर काही आक्षेप असल्यास आपला आक्षेप लेखी स्वरुपात\nआवश्यक दस्ताऐवजासह दिनांक ३१ जूलै २०२६ रोजी सायं.०५:०० वाजेपर्यंत राष्ट्रीय\nनागरी आरोग्य अभियान कार्यालय, आरोग्य विभाग, ५ वा माळा, नागपूर\nमहानगरपालिका, सिव्हिल लाईल, नागपूर येथे जमा करण्यात यावे. सदर तारखेनंतर\nप्राप्त होणारे आक्षेप याकार्यालयाद्वारे ग्राह्य केले जाणार नाही, याची सर्व संवंधीत\nकर्मचाऱ्यांनी नोंद घ्यावी."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        139.12,
        836.91,
        391.78,
        836.91,
        391.78,
        876.29,
        139.12,
        876.29
      ],
      "text": "सोबतः- कर्मचाऱ्यांची यादी."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        651.1,
        899.27,
        895.97,
