        372.82,
        294.49,
        391.75,
        39.3,
        391.75
      ],
      "text": "महानिर्धापत्ता, महारायुद्ध ने ने, जैंड़ै. (४५० प्रती),"
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        39.3,
        392.57,
        294.49,
        392.57,
        294.49,
        409.03,
        39.3,
        409.03
      ],
      "text": "महारोगापता, महाराण्ड डै, दायूर, (२९ पूर्टी),"
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        39.3,
        409.85,
        212.74,
        409.85,
        212.74,
        426.31,
        39.3,
        426.31
      ],
      "text": "अर्थित्रा वे नहीं अर्थित्रा, शुर्ध,"
    },
    {
      "id": 13,
      "type": "text",
      "order": 13,
      "poly": [
        39.3,
        427.14,
        235.28,
        427.14,
        235.28,
        444.42,
        39.3,
        444.42
      ],
      "text": "विधाला नेहा पर्ट्रांक ए अधिकरी, गुड़ु,"
    },
    {
      "id": 14,
      "type": "text",
      "order": 14,
      "poly": [
        39.3,
        445.24,
        282.44,
        445.24,
        282.44,
        462.53,
        39.3,
        462.53
      ],
      "text": "मुख्य लेखा पर्ट्राक्त, श्वारिक लेखा, गुड्यू,"
