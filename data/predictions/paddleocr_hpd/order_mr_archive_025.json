      "type": "text",
      "order": 17,
      "poly": [
        34.06,
        498.74,
        256.76,
        498.74,
        256.76,
        516.02,
        34.06,
        516.02
      ],
      "text": "स्तुं मेंर्थिति वे लियांकरी टी दीय डारा डां, उस व्यापात्य, गुर्वं,"
    },
    {
      "id": 18,
      "type": "text",
      "order": 18,
      "poly": [
        34.06,
        517.67,
        303.92,
        517.67,
        303.92,
        534.95,
        34.06,
        534.95
      ],
      "text": "*मूर्विक, मूर्व श्रायायत्य गाधां, उस श्रायायत्य, गुर्वू,"
    },
    {
      "id": 19,
      "type": "text",
      "order": 19,
      "poly": [
        34.06,
        535.77,
        268.29,
        535.77,
        268.29,
        553.06,
        34.06,
        553.06
      ],
      "text": "*देशक, अत्ता गाधान, अक्ष व्यापात्य, निर्देश,"
    },
    {
      "id": 20,
      "type": "text",
      "order": 20,
      "poly": [
        34.06,
        553.88,
        259.38,
        553.88,
        259.38,
        571.16,
        34.06,
        571.16
      ],
      "text": "*सिंधि, महाराज्ञू लोकेन्दा अर्तार्य, गुड़ू,"
    },
    {
      "id": 21,
      "type": "text",
      "order": 21,
      "poly": [
        34.06,
        571.99,
        285.58,
        571.99,
        285.58,
        589.27,
        34.06,
        589.27
      ],
      "text": "*स्विध, महाराज डे विर्गर्विक्षित स्विधालय, गुर्वू,"
    },
    {
      "id": 22,
      "type": "text",
      "order": 22,
      "poly": [
        34.06,
        590.09,
        362.61,
        590.09,
        362.61,
        608.2,
        34.06,
        608.2
      ],
