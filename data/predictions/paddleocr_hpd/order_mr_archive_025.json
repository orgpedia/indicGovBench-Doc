    {
      "id": 24,
      "type": "text",
      "order": 24,
      "poly": [
        37.2,
        626.3,
        434.4,
        626.3,
        434.4,
        661.69,
        37.2,
        661.69
      ],
      "text": "जूल्यायार्या विर्मिक्ताया विस्मानिया अधित अधेन्द्रा स्व विभार्यी व कार्यालयी प्रभु,"
