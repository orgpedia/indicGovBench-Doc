    {
      "id": 15,
      "type": "text",
      "order": 15,
      "poly": [
        39.3,
        463.35,
        138.34,
        463.35,
        138.34,
        479.81,
        39.3,
        479.81
      ],
      "text": "रूप गर्यी औविध,"
    },
    {
      "id": 16,
      "type": "text",
      "order": 16,
      "poly": [
        39.3,
        481.45,
        141.48,
        481.45,
        141.48,
        497.91,
        39.3,
        497.91
      ],
      "text": "युद्धर गर्यी दीविध,"
