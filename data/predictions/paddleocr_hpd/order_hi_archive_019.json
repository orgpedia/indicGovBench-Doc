    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        47.6,
        137.25,
        538.48,
        137.25,
        538.48,
        196.19,
        47.6,
        196.19
      ],
      "text": "2.2016 दारा सुधि वेवसाहट पर स्वूड़ो से अपडेट्ट जाता के अनुक्षण आगणनों के पर्थांग के संबंध में दिशा-नद्ध्री निम्ति किये गये थे एवं अग्रेधा की मागी थी कि मुख्यालय की प्रेवित किये जाने वाले आगणनों में स्थीय एवं बुतीय कार्यालयों दारा माग की थेगी, लम्बाई, कर्ट, लोगित सत्तु की बोजड़ एवं नवीनीकरण का वर्थ आदि विरण को सुधि वेवसाहट पर स्वूड़ो से अपडेट्ट जाता से पुधि उपरान प्रेवित किया जाये।"
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        49.98,
        195.34,
        537.28,
        195.34,
        537.28,
        296.38,
        49.98,
        296.38
      ],
      "text": "जलेखनीय है कि किसी मी मान के निम्भांग के प्राराम से लेकर समय–समय पर समयित विमिन्न कार्य की विवित परिविए मान विश्रेष से स्ववित मान परिलेख (डौटृ0आई) में पत्रेक बर्ष की जाती है एव उसरी संबंधित विरण की साए एव हात्ह परतिया पमुख अमियन्ता कार्यालय को प्रेवित की जाती रही है। रयिए वेवसाहुत के सुजनोपरान्त रामस्त मान के पत्रेक किमी। का अध्यविक्त विरण वेवसाहुत के विगिन्न रामों में अंकित करने के निदेश दिये गये ए एव तदनुसार ही वेवसाहुत पर उपलब्ध घाला एव आगणन में सहत्न प्रयां-1'क' में जलेखन्थित मान की कर्ट न्वीनीकरण का माह्त/वूर्य, यातायात्र गणना के आकड़ी का निलान कर पुष्यालय स्तर पर आगणनों के प्रेवित की कार्यवाही समयित की जा रही है।"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        54.74,
        295.54,
        535.5,
        295.54,
        535.5,
        324.17,
        54.74,
        324.17
      ],
      "text": "भेन दारा प्रेवित आगणनो में वेकलितर (प्रपत्र-1'क) में अंकित भान के विरिन्न कियो के कर्ट, नवीनीकरण का माह्ज/वर्य, यातायाता गणना के अकडे तथा वेवसाहट पर उपल्ख अकड्यो में गिन्नाता -दी ली- शाहिए!"
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        55.93,
        323.33,
        534.31,
        323.33,
        534.31,
        408.37,
        55.93,
        408.37
      ],
      "text": "अत: एत्तर्वरा निर्दरित किया जाता है कि महिया में आगणनों के वेया रो एद बर्ग-युन्दिर्वत किया जाए कि� सहिट की वेवसाहट पर वही घता अंकित ही जो एद में मार परिलेख में अंकित है वर्ग परिर्थितियों में माग के अमिलेखीय कर्ट एद वार्तविक कर्ट में जिनाता है तो कर्ट की कर्ट रेड राया रार से अनुमाहेन एद उत्तरदारी अधिकार्यों एद कुन्द्यार्यों के गार व पदना के शाए उत्तरदार्यित्य के गिर्णोमार्त ही गार के बीधिकरण/सुद्धांकरण के आगणन प्रेमित किये जाए। शरी प्रकर पार के शाधार्त मंत्री एद रांक्षित्यार्त ही गार के सवाल्य प्राथिकता के आधार पर प्रेमित्योमार्त शरी की वेवसाहट पर अक्षित्य किया शाए रांक्षित्य किया जाए।"
