        202.92,
        114.24,
        202.92
      ],
      "text": "The undersigned is directed to say that with effect from the 19th September, 1995 -"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        148.16,
        212.18,
        533.12,
        212.18,
        533.12,
        289.65,
        148.16,
        289.65
      ],
      "text": "(i) Shri Eduardo Faleiro, Minister of State in the Ministry of Chemicals and Fertilisers, Minister of State in the Ministry of Parliamentary Affairs and Minister of State in the Departments of Electronics and Ocean Development, relinquished the additional charge of the office of the Minister of State in the Ministry of Parliamentary Affairs."
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        144.59,
        291.33,
        534.31,
        291.33,
        534.31,
        359.53,
        144.59,
        359.53
      ],
      "text": "(ii) Smt. Krishna Sahi relinquished the office of the Minister of State in the Ministry of Civil Supplies, Consumer Affairs and Public Distribution and assumed the office of the Minister of State in the Ministry of Civil Supplies, Consumer Affairs and Public Distribution (Department of Civil Supplies)."
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        139.82,
        360.38,
        537.28,
        360.38,
        537.28,
        477.41,
        139.82,
        477.41
      ],
      "text": "(iii) Shri Mallikarjun, Minister of State in the Ministry of Defence, Minister of State in the Ministry of Parliamentary Affairs and Minister of State in the Ministry of Railways, relinquished the office of the Ministry of State in the Ministry of Defence and the Minister of State in the Ministry of the Minister of the additional charge of the office of the Minister of State in the Ministry of Railways and assumed the office of the Minister of State in the Ministry of Defence (Department of Defence). He will continue to hold the charge of the office of the Minister of State in the Ministry of Parliamentary Affairs."
    },
    {
      "id": 13,
      "type": "text",
      "order": 13,
      "poly": [
        149.34,
        479.1,
        539.07,
        479.1,
        539.07,
        537.2,
        149.34,
        537.2
      ],
      "text": "(iv) Shri S.S. Ahluwalia, Minister of State in the Ministry of Urban Affairs and Employment (Department of Urban Employment and Poverty Alleviation), assumed the charge of the office, also, of the Minister of State in the Ministry of Parliamentary Affairs."
    },
    {
      "id": 14,
      "type": "text",
      "order": 14,
      "poly": [
        157.68,
        538.88,
        542.05,
        538.88,
        542.05,
        615.5,
        157.68,
        615.5
      ],
      "text": "(v) Shri Venod Sharma relinquished the office of the Minister of State in the Ministry of Civil Supplies, Consumer Affairs and Public Distribution and assumed the office of the Minister of State in the Ministry of Civil Supplies, Consumer Affairs and Public Distribution (Department of Consumer Affairs and Public Distribution System)."
    },
