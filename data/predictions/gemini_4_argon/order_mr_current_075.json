      ],
      "text": "विषय:- माघी गणेशोत्सव – २०२३ साजरा करणेबाबत."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        74.5,
        142.3,
        498.85,
        142.3,
        498.85,
        173.45,
        74.5,
        173.45
      ],
      "text": "माघी गणेशोत्सव २५ जानेवारी, २०२३ पासून साजरा होणार आहे. माघी गणेशोत्सवाबाबत\nमा.मनपा आयुक्तांनी पुढीलप्रमाणे मार्गदर्शक सूचना प्रसारित करण्यास मंजूरी दिली आहे –"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        101.92,
        174.29,
        498.26,
        174.29,
        498.26,
        282.91,
        101.92,
        282.91
      ],
      "text": "1. आगामी माघी गणेशोत्सवादरम्यान असलेला अल्प कालावधी व तदनंतर लगेचच साजरा होणाऱ्या\nप्रजासत्ताक दिनाच्या पूर्वतयारीमध्ये पोलिसांची असलेली व्यस्तता, याबाबी विचारात घेवून माघी\nगणेशोत्सवासाठी प्राप्त होणाऱ्या अर्जापैकी ज्या मंडळांना गतवर्षी परवानगी देण्यात आली आहे,\nअशा मंडळांचे अर्ज स्थानिक/वाहतूक पोलिसांकडे न पाठवता, मागील वर्षीची परवानगी ग्राह्य\nधरुन विभाग कार्यालयामार्फत छाननी करुन परवानगी देण्यात यावी. नव्याने / प्रथमतः अर्ज\nकरणाऱ्या मंडळांच्या अर्जाच्या बाबतीत मात्र स्थानिक/वाहतूक पोलिसांचे ना-हरकत प्रमाणपत्र\nघेण्यात यावे."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        99.53,
        286.28,
        497.06,
        286.28,
        497.06,
        330.06,
        99.53,
        330.06
      ],
      "text": "2. विभागीय सहाय्यक आयुक्तांनी त्यांच्या अधिपत्याखालील विभागात माघी गणेशोत्सवादरम्यान\nउभारावयाच्या कृत्रिम तलावांची आवश्यकता पडताळावी व आवश्यक सुविधा उपलब्ध करुन\nदेण्यात याव्यात."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        98.94,
        334.27,
        495.87,
        334.27,
        495.87,
        362.9,
        98.94,
        362.9
      ],
      "text": "3. माघी गणेशोत्सवादरम्यान मंडप उभारणीच्या परवानगीसाठी प्रतिवर्षीप्रमाणे असंगणकीय\nकार्यपद्धतीचा अवलंब करावा."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        98.34,
        365.43,
        495.87,
        365.43,
        495.87,
        413.42,
        98.34,
        413.42
      ],
      "text": "4. कोविड-१९ किंवा त्याच्या विविध प्रकारांच्या प्रादूर्भावाचा पुनरुद्धवाचा संभाव्य धोका विचारात\nघेता, शासनाने उत्सव कालावधीत कोविड-१९ या साथरोगाच्या पार्श्वभूमीवर निर्बंध जारी केल्यास\nत्याचे पालन केले जाईल, अशा आशयाचे हमीपत्र मंडळांकडून स्वीकारावे."
    },
