      ],
      "text": "मुंबई वित्तीय नियम १९५९ मध्ये\nसुधारणा करण्याबाबत."
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        55.78,
        74.53,
        379.97,
        74.53,
        379.97,
        143.32,
        55.78,
        143.32
      ],
      "text": "महाराष्ट्र शासन,\nवित्त विभाग,\nनिर्णय क्रमांकः एफएनआर-१०८३/प्र. क्र. १३५/ कोषागारे-६,\nमंत्रालय, मुंबई ४०० ०३२, दिनांक २३ सप्टेंबर १९८७."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        167.33,
        153.97,
        221.11,
        153.97,
        221.11,
        172.81,
        167.33,
        172.81
      ],
      "text": "निर्णय"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        11.45,
        186.73,
        465.13,
        186.73,
        465.13,
        237.51,
        11.45,
        237.51
      ],
      "text": "शासन असा आदेश देत आहे की, मुंबई वित्तीय नियम १९५९, प्रकरण क्र.११\nमधील खाली नमूद केलेल्या नियमांत त्यासमोर दर्शविल्याप्रमाणे सुधारणा करण्यात\nयावी."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        41.83,
        250.61,
        437.24,
        250.61,
        437.24,
        286.65,
        41.83,
        286.65
      ],
      "text": "नियम क्रमांक १३३ :- उप नियम [तीन] मधील \"OR BOAT \" हे शब्द\nगाळण्यांत यावेत."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        147.41,
        292.38,
        484.55,
        292.38,
        484.55,
        328.42,
        147.41,
        328.42
      ],
      "text": "--- उपनियम [सात] मध्ये विवरणपत्राच्या पहिल्या\nओळीतील \"OR MOTOR BOAT\" हे शब्द गाळण्यांत यावेत."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        42.83,
        342.34,
        483.06,
        342.34,
        483.06,
        375.1,
        42.83,
        375.1
      ],
      "text": "नियम क्रमांक १३६ :- या नियमाच्या प्रारंभीच्या ओळींतील \" OR A MOTOR\nBOAT\" हे शब्द गाळण्यात यावेत."
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        147.41,
        383.29,
        488.54,
