        231.55,
        359.38,
        247.55,
        113.64,
        247.55
      ],
      "text": "विषयः-अनुभव प्रमाण-पत्र निर्गत करने के सम्बन्ध में।"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        113.64,
        267.76,
        555.13,
        267.76,
        555.13,
        378.06,
        113.64,
        378.06
      ],
      "text": "यह प्रकाश में आया है कि खण्डों द्वारा कार्य समाप्ति के उपरान्त जारी किये जाने\nवाले अनुभव प्रमाण-पत्र में पूर्ण विवरण जैसे कार्य समाप्ति की तिथि, कार्य पूर्ण होने की वास्तविक\nतिथि, कार्य की लागत, अतिरिक्त कार्य की लागत एवं कार्य के अन्तर्गत सम्पादित किये गये\nविभिन्न मदों की मात्रा एवं धनराशि के सम्बन्ध में पूर्ण स्थिति वर्णित न करने के कारण मूल्यांकन\nप्रक्रिया में असमंजस स्थिति उत्पन्न हो जाती है।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        113.64,
        393.21,
        555.73,
        393.21,
        555.73,
        432.79,
        113.64,
        432.79
      ],
      "text": "अतः एतद्द्वारा आदेश पारित किये जाते हैं कि भविष्य में निर्धारित संलग्न प्रारूप पर\nही अनुभव प्रमाण-पत्र निर्गत करना सुनिश्चित किया जायेगा।"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        176.72,
        447.1,
        477.19,
        447.1,
        477.19,
        463.94,
        176.72,
        463.94
      ],
      "text": "उक्त आदेशों का कड़ाई से अनुपालन किया जाना सुनिश्चित करें।"
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
