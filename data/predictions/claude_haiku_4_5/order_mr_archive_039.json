    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        149.4,
        237.51,
        448.2,
        237.51,
        448.2,
        311.22,
        149.4,
        311.22
      ],
      "text": "शासन अत्र आदेश देत आहे की, मुंबई परिषदीय निणय १२४२, प्रकरण प्र. ११\nमधील बाकी नमूद केलेल्या निणयोत स्वतंत्र दर्शविलेप्रभाणे हुप्पारणा\nघाकी."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        149.4,
        319.41,
        448.2,
        319.41,
        448.2,
        368.55,
        149.4,
        368.55
      ],
      "text": "निणय प्रमाणक १२३ :- उप निणय [पीच] मधील \"OR BOAT \" हे शब्द\nगुळवडीत घाकेत."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        149.4,
        376.74,
        448.2,
        376.74,
        448.2,
        425.88,
        149.4,
        425.88
      ],
      "text": "उप निणय [तात] माध्ये पिपलणपाषता घडीतील \"OR MOTOR BOAT\"हे शब्द गुळवडीत घाकेत."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        149.4,
        434.07,
