        684.55
      ],
      "text": "विषय:- नवीन आपराधिक कानूनों एवं विशेष अधिनियमों के प्रभावी क्रियान्वयन हेतु प्राप्तसफलता\nकी कहानियों को सर्कुलेट करने हेतु।"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        107.69,
        314.07,
        427.81,
        314.07,
        427.81,
        616.34,
        107.69,
        616.34
      ],
      "text": "संदर्भ:- छाया शर्मा, संचालक (ट्रेनिंग) बीपीआरएण्डडी गृह मंत्रालय भारत सरकार का पत्र\nदिनांक 22/08/2025 एवं संलग्न सफलता की कहानियां।"
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        261.8,
        355.32,
        267.16,
        355.32,
        267.16,
        434.47,
