    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        101.75,
        377.22,
        346.29,
        377.22,
        346.29,
        693.81,
        101.75,
        693.81
      ],
      "text": "कृपया विषयांकित संदर्भित पत्र एवं संलग्न सफलता की कहानियों का अवलोकन करने का कष्ट करें।\nसुश्री छाया शर्मा, संचालक (ट्रेनिंग), बीपीआरएण्डडी, गृह मंत्रालय, भारत सरकार द्वारा नवीन आपराधिक\nकानूनों एवं विशेष अधिनियमों के प्रभावी क्रियान्वयन हेतु हरियाणा, तेलंगाना, उ.प्र. एवं दिल्ली से प्राप्त\nसफलता की कहानियां संलग्न कर प्रेषित की है।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        101.75,
        450.47,
        352.83,
        450.47,
        352.83,
        692.97,
        101.75,
        692.97
      ],
      "text": "अतः नवीन आपराधिक कानूनों एवं विशेष अधिनियमों के प्रभावी क्रियान्वयन हेतु उक्त प्राप्त\nसफलता की कहानियां अपने अधिनस्थों को सर्कुलेट करने का कष्ट करें।"
    },
