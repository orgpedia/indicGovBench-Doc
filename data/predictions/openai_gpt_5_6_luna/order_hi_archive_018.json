      ],
      "text": "प्रेषक,\n\nनगेन्द्र सिंह,\nप्रमुख सचिव,\nउत्तर प्रदेश शासन ।"
    },
    {
      "id": 2,
      "type": "text",
      "order": 2,
      "poly": [
        142.2,
        185.24,
        437.92,
        185.24,
        437.92,
        609.61,
        142.2,
        609.61
      ],
      "text": "सेवा में,\n\nसमस्त मण्डलायुक्त,\nसमस्त विभागाध्यक्ष एवं प्रमुख कार्यालयाध्यक्ष,\nउत्तर प्रदेश ।"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        351.05,
