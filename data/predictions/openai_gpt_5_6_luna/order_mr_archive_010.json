        429.76,
        59.74,
        429.76,
        455.88,
        416.16,
        455.88
      ],
      "text": "शामगुरु स्टेशनरी प्रेस-१००४ (१,४००+ ८०-१२-६७)"
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        343.81,
        72.31,
        468.38,
        72.31,
        468.38,
        88.03,
        343.81,
        88.03
      ],
      "text": "मागणी भरता देण्यात यावा."
