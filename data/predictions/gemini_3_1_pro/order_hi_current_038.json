      "poly": [
        76.16,
        288.81,
        518.25,
        288.81,
        518.25,
        329.22,
        76.16,
        329.22
      ],
      "text": "वर्षा ऋतु के आगमन को दृष्टिगत रखते हुए विभागीय परिसंपत्तियों की सुरक्षा , यातायात की निर्बाध\nव्यवस्था, जनसुरक्षा तथा आपदा प्रबंधन को सुनिश्चित करने के लिए पूर्व में जारी निर्देशों के तारतम्य में\nनिम्नानुसार कार्यवाही तत्काल की जाना सुनिश्चित करें :-"
    },
    {
      "id": 20,
      "type": "text",
      "order": 20,
      "poly": [
        76.16,
        330.06,
        203.49,
        330.06,
        203.49,
        343.54,
        76.16,
        343.54
      ],
      "text": "1. आपदा एवं अतिवृष्टि प्रबंधन"
    },
    {
      "id": 21,
      "type": "text",
      "order": 21,
      "poly": [
        88.66,
        343.54,
        518.25,
        343.54,
        518.25,
        383.11,
        88.66,
        383.11
      ],
      "text": "1. राज्य स्तरीय कण्ट्रोल रूम की स्थापना में, म.प्र. सड़क विकास नगम के द्वारा संचालित एक्सीडेंट\nरिस्पांस सिस्टम के टोल फ्री नंबर 1099 का उपयोग किया जाकर आवश्यक कार्ययोजना तैयार की जाए\n।"
    },
    {
      "id": 22,
      "type": "text",
      "order": 22,
      "poly": [
        88.66,
        383.95,
        514.67,
        383.95,
        514.67,
        410.9,
        88.66,
        410.9
      ],
      "text": "2. प्रत्येक जोन/संभाग/जिला/डिवीजन स्तर पर त्वरित कार्यवाही दल (Rapid Response Team)\nगठित किया जाए।"
    },
    {
      "id": 23,
      "type": "text",
      "order": 23,
      "poly": [
        88.66,
        410.9,
        497.42,
        410.9,
        497.42,
        424.37,
        88.66,
        424.37
      ],
      "text": "3. आवश्यक मशीनरी, वाहन, निर्माण सामग्री एवं मानव संसाधन की अग्रिम व्यवस्था सुनिश्चित की जाए।"
    },
    {
      "id": 24,
      "type": "text",
      "order": 24,
      "poly": [
        88.66,
        425.21,
        508.72,
        425.21,
        508.72,
        438.68,
        88.66,
        438.68
      ],
      "text": "4. अतिवृष्टि, बाढ़ अथवा मार्ग अवरुद्ध होने की स्थिति में तत्काल यातायात बहाली हेतु कार्यवाही की जाए।"
    },
    {
      "id": 25,
      "type": "text",
      "order": 25,
      "poly": [
        88.66,
        438.68,
        518.25,
        438.68,
        518.25,
        465.63,
        88.66,
        465.63
      ],
      "text": "5. संवेदनशील स्थलों की सूची तैयार कर मैपिंग कर नियमित निगरानी रखी जाए एवं मौसम के पूर्वानुमान को\nध्यान में रखते हुए आवश्यक मैदानी अमले की तैनाती सुनिश्चित की जाए।"
    },
    {
      "id": 26,
      "type": "text",
      "order": 26,
      "poly": [
        88.66,
        466.47,
        518.25,
        466.47,
        518.25,
        493.41,
        88.66,
        493.41
      ],
      "text": "6. आपदा एवं अतिवृष्टि प्रबंधन हेतु संबंधित जिला प्रशासन, होम गार्ड एवं आपदा प्रबंधन अमले से आवश्यक\nसमन्वय सुनिश्चित किया जाए।"
    },
    {
      "id": 27,
      "type": "text",
      "order": 27,
      "poly": [
        76.16,
        493.41,
        183.85,
        493.41,
        183.85,
        506.88,
        76.16,
        506.88
      ],
      "text": "2. मॉनिटरिंग एवं प्रतिवेदन"
    },
    {
      "id": 28,
      "type": "text",
      "order": 28,
      "poly": [
        88.66,
        506.88,
        518.25,
        506.88,
        518.25,
        547.3,
        88.66,
        547.3
      ],
      "text": "1. वर्षा ऋतु पूर्व किए गए कार्यों की समीक्षा कर, सभी मुख्य अभियन्ता ( B&R) एवं संभागीय प्रबंधक, म.प्र\nसड़क विकास निगम द्वारा संबंधित जोन/संभाग की सड़कों को पॉट होल फ्री होने का प्रमाणित प्रतिवेदन\nदिनांक 30 जून 2026 तक प्रस्तुत किया जाए।"
    },
    {
      "id": 29,
      "type": "text",
      "order": 29,
      "poly": [
        88.66,
        548.14,
        518.25,
        548.14,
        518.25,
        575.09,
        88.66,
        575.09
      ],
      "text": "2. सभी मुख्य अभियंता द्वारा वर्षा काल के दौरान प्रत्येक 2-3 दिन में फील्ड अमले एवं ठेकेदारों के साथ\nकार्यों की समीक्षा की जाए।"
    },
    {
      "id": 30,
      "type": "text",
      "order": 30,
      "poly": [
        88.66,
        575.09,
        518.25,
        575.09,
        518.25,
        602.03,
        88.66,
        602.03
      ],
      "text": "3. वर्षा ऋतु के दौरान क्षति, मरम्मत एवं यातायात बहाली संबंधी जानकारी नियमित रूप से अद्यतन की\nजाए।"
    },
    {
      "id": 31,
      "type": "text",
      "order": 31,
      "poly": [
        88.66,
        602.87,
        518.25,
        602.87,
        518.25,
        629.82,
        88.66,
        629.82
      ],
      "text": "4. प्रत्येक अधिकारी अपने कार्यक्षेत्र में जनसुरक्षा एवं परिसंपत्तियों की सुरक्षा हेतु व्यक्तिगत रूप से उत्तरदायी\nरहेगा।"
    },
    {
      "id": 32,
      "type": "text",
      "order": 32,
      "poly": [
        76.16,
        629.82,
        518.25,
        629.82,
        518.25,
        656.76,
        76.16,
        656.76
      ],
      "text": "उक्त निर्देशों का कड़ाई से पालन सुनिश्चित किया जाए तथा किसी भी प्रकार की लापरवाही के लिए संबंधित\nअधिकारी उत्तरदायी होंगे।"
    },
