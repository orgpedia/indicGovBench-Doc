    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        59.94,
        259.84,
        456.18,
        259.84,
        456.18,
        279.46,
        59.94,
        279.46
      ],
      "text": "\"हमी - भारताच्या संविधानातील अनुच्छेद २९३(१) मधील तरतुदीखाली"
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        18.8,
        284.17,
        470.92,
        284.17,
        470.92,
        304.58,
        18.8,
        304.58
      ],
      "text": "राज्यास कर्जाऊ रकमा घेण्याचे व हमी देण्याचे अधिकार सुपूर्द केलेले आहेत. यासाठी"
    },
    {
      "id": 12,
      "type": "text",
      "order": 12,
      "poly": [
        19.3,
        308.5,
        491.74,
        308.5,
        491.74,
        328.91,
        19.3,
        328.91
      ],
      "text": "विधीमंडळाकडून जर काही मर्यादा निश्चित केल्या गेल्या असतील तर, त्या मर्यादांच्या"
    },
    {
      "id": 13,
      "type": "text",
      "order": 13,
      "poly": [
        19.3,
        332.06,
        496.82,
        332.06,
        496.82,
        352.47,
        19.3,
        352.47
      ],
      "text": "आत या अधिकारांचा वापर राज्य शासनास करता येतो. मुंबई राज्य हमी अधिनिय,"
    },
    {
      "id": 14,
      "type": "text",
      "order": 14,
      "poly": [
        20.83,
        355.61,
        485.65,
        355.61,
        485.65,
        376.01,
        20.83,
        376.01
      ],
      "text": "१९५८नुसार राज्यात हमी देण्याच्या अधिकाराच्या बाबतीत १५० कोटी रुपयांची"
    },
    {
      "id": 15,
      "type": "text",
      "order": 15,
      "poly": [
        20.83,
        379.94,
        470.41,
        379.94,
        470.41,
        400.35,
        20.83,
        400.35
      ],
      "text": "मर्यादा विहित केलेली होती. परंतु या कायद्याचे नंतर मुंबई राज्य हमी (निरसन)"
    },
    {
      "id": 16,
      "type": "text",
      "order": 16,
      "poly": [
        20.83,
        403.49,
        471.42,
        403.49,
        471.42,
        423.9,
        20.83,
        423.9
      ],
      "text": "अधिनिय, १९६४ या अन्वये निरसन करण्यात आले. अशा रीतीने आता कितीही"
    },
    {
      "id": 17,
      "type": "text",
      "order": 17,
      "poly": [
        21.84,
        427.83,
        488.19,
        427.83,
        488.19,
        448.23,
        21.84,
        448.23
      ],
      "text": "मर्यादेपर्यंत हमी मंजूर करण्यास राज्य शासन सक्षम झाले आहे. सन १९७७-७८ अखेरीस"
    },
    {
      "id": 18,
      "type": "text",
      "order": 18,
      "poly": [
        22.35,
        451.37,
        491.74,
        451.37,
        491.74,
        471.78,
        22.35,
        471.78
      ],
      "text": "राज्य शासनाने दिलेल्या हमीची एकूण अदत्त (आउट स्टँडिंग) रक्कम अंदाजे ९८६ कोटी"
    },
    {
      "id": 19,
      "type": "text",
      "order": 19,
      "poly": [
        21.84,
        475.71,
        455.17,
        475.71,
        455.17,
        496.12,
        21.84,
        496.12
      ],
      "text": "एवढी म्हणे १९५८ च्या अधिनियमातील मर्यादेच्या सहा पटीपेक्षा अधिक होती."
    },
    {
      "id": 20,
      "type": "text",
      "order": 20,
      "poly": [
        22.35,
        499.26,
        455.17,
        499.26,
        455.17,
        519.67,
        22.35,
        519.67
      ],
      "text": "हमीच्या दायित्वाच्या प्रतिपूर्तीसंबंधी शासनाची जी कार्यपद्धती आहे. त्यानुसार"
    },
    {
      "id": 21,
      "type": "text",
      "order": 21,
      "poly": [
        22.86,
        523.6,
        494.28,
        523.6,
        494.28,
        544.0,
        22.86,
        544.0
      ],
      "text": "जेव्हा हमीच्या प्रतिपूर्तीचे आवाहन केले जाते तेव्हा ज्यांच्या वतीने हमी देण्यात आली"
    },
    {
      "id": 22,
      "type": "text",
      "order": 22,
      "poly": [
        22.86,
        547.93,
        459.23,
        547.93,
        459.23,
        568.34,
        22.86,
        568.34
      ],
      "text": "आहे. त्या संस्थांना आवश्यक ते कर्ज मंजूर करून आपले दायित्व पार पाडण्यास"
    },
    {
      "id": 23,
      "type": "text",
      "order": 23,
      "poly": [
        22.86,
        571.48,
        481.08,
        571.48,
        481.08,
        591.89,
        22.86,
        591.89
      ],
      "text": "समर्थ केले जाते व नंतर हे कर्ज सुलभ हप्त्यांत व्याजासह वसूल केले जाते. वर निर्देश"
    },
    {
      "id": 24,
      "type": "text",
      "order": 24,
      "poly": [
        22.35,
        595.82,
        475.49,
        595.82,
        475.49,
        616.23,
        22.35,
        616.23
      ],
      "text": "केल्याप्रमाणे हमीची अदत्त (आउट स्टॅन्डिंग) रक्कम फार मोठ्या प्रमाणात वाढलेली"
    },
