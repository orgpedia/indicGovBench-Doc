      "id": 25,
      "type": "text",
      "order": 25,
      "poly": [
        22.35,
        620.15,
        480.57,
        620.15,
        480.57,
        640.56,
        22.35,
        640.56
      ],
      "text": "असल्याकारणान यापुढे शासनाने हमीसंबंधी अधिकाधिक जबाबदारी स्वीकारण्यापूर्वी"
    },
    {
      "id": 26,
      "type": "text",
      "order": 26,
      "poly": [
        22.35,
        643.7,
        489.2,
        643.7,
        489.2,
        664.11,
        22.35,
        664.11
      ],
      "text": "प्रत्येक प्रकरणाची अत्यंत काटेकोरपणे व काळजीपूर्वक तपासणी करणे आवश्यक आहे. तसेच"
    },
    {
      "id": 27,
      "type": "text",
      "order": 27,
      "poly": [
        22.35,
        668.03,
        466.34,
        668.03,
        466.34,
        688.45,
        22.35,
        688.45
      ],
      "text": "ज्या संस्थांना त्यांचे दायित्व पार पाडण्यासाठी कर्जे दिलेली आहेत त्यांच्याकडून"
    },
    {
      "id": 28,
      "type": "text",
