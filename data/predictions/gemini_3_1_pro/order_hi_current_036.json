      "html": "<table><thead><tr><td rowspan=\"2\">क्र०सं०</td><td rowspan=\"2\">परियोजना\nका नाम</td><td rowspan=\"2\">अनुदान\nसं०/\nलेखाशीर्षक</td><td rowspan=\"2\">वित्तीय\nवर्ष\n2023-24\nमें\nप्राविधाति\nत बजट</td><td rowspan=\"2\">शासन द्वारा\nप्रदत्त स्\nवीकृति का\nसंदर्भ\nशासनादेश\nसं०- /\nदिनांक</td><td rowspan=\"2\">प्रशासकीय स्\nवीकृति की\nलागत\n(a) /\nगठित\nअनुबंध की\nलागत (b)</td><td rowspan=\"2\">अनुबन्धित\nलागत के\nआधार पर\nकार्य की\nपुनरीक्षित\nलागत</td><td rowspan=\"2\">गठित\nअनुबन्ध/\nपुनरीक्षित\nलागत के\nआधार पर\nबचत\n{6(a)-7}</td><td rowspan=\"2\">अब तक\nक्रमिक\nआवंटन</td><td rowspan=\"2\">परियोजना\nपर आवंटन\nहेतु अवशेष\nधनराशि\n(पुनरीक्षित\nलागत\nसापेक्ष)\n(7-9)</td><td colspan=\"2\">वित्तीय वर्ष\n2023-24 में</td></tr><tr><td>अनुदान\nसं०/ले\nखा\nशीर्षक</td><td>अवमुक्त\nकी जाने\nवाली प्रस्\nतावित\nधनराशि</td></tr></thead><tbody><tr><td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td><td>9</td><td>10</td><td>11</td><td>12</td></tr><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr></tbody></table>"
