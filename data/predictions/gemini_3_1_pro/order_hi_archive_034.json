      ],
      "text": "प्रमुख अभियंता,\nसमस्त मुख्य अभियंता\nसमस्त अधीक्षण यंत्री,\nसमस्त कार्यपालन यंत्री,\nलोक निर्माण विभाग, मध्यप्रदेश"
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        94.01,
        185.24,
        540.26,
        185.24,
        540.26,
        215.55,
        94.01,
        215.55
      ],
      "text": "विषयः-कार्यविभाग नियमावली 1983 भाग-1 की कंडिका 2.080 के अनुसार प्रारूप निविदा\n(Draft N.I.T.) अनुमोदन के संबंध में दिशा निर्देश ।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        94.61,
        229.87,
        540.26,
        229.87,
        540.26,
        272.81,
        94.61,
        272.81
      ],
      "text": "म.प्र.शासन, लोक निर्माण विभाग के आदेश कमांक एफ 39/19/यो/2012/1553, दिनांक\n2.3.2012 द्वारा कार्यविभाग नियमावली 1983 भाग-1 की कंडिका 2.080 में आंशिक संशोधन करते हुए\nपरिपत्र के बिन्दु क्रमांक-2 में जारी -"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        130.31,
        288.81,
        513.49,
        288.81,
        513.49,
        381.43,
        130.31,
        381.43
      ],
      "text": "\"प्रमुख अभियंता एवं शासन के सक्षम / क्षेत्राधिकार की समस्त निविदाओं के निविदा\nप्रारूप (Draft N.I.T.) का अनुमोदन मुख्य अभियंता द्वारा एवं कार्यपालन यंत्री के\nसक्षम/क्षेत्राधिकार की सड़क कार्यों की निविदाओं के निविदा प्रारूप (Draft N.I.T.)\nका अनुमोदन अधीक्षण यंत्री द्वारा किया जायेगा । मुख्य अभियंता, अधीक्षण यंत्री एवं\nकार्यपालन यंत्री के सक्षम / क्षेत्राधिकार की शेष अन्य सभी निविदाओं के निविदा\nप्रारूप का अनुमोदन कंडिका 2.080 के तहत यथावत किया जावेगा ।\""
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        131.5,
        394.9,
        492.06,
        394.9,
        492.06,
        410.05,
        131.5,
        410.05
      ],
      "text": "आदेश को पुनः संशोधित कर एतद् द्वारा निम्नानुसार आदेश जारी किये जाते हैं -"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        131.5,
        416.79,
        514.67,
        416.79,
        514.67,
        505.2,
        131.5,
        505.2
      ],
      "text": "\"प्रमुख अभियंता एवं शासन के सक्षम / क्षेत्राधिकार की समस्त निविदाओं के निविदा\nप्रारूप (Draft N.I.T.) का अनुमोदन मुख्य अभियंता द्वारा एवं मुख्य अभियंता, अधीक्षण\nयंत्री एवं कार्यपालन यंत्री के सक्षम / क्षेत्राधिकार की सभी निविदाओं के निविदा\nप्रारूप का अनुमोदन कार्यविभाग नियमावली 1983 भाग-1 की कंडिका 2.080 के तहत\nयथावत कमशः मुख्य अभियंता, अधीक्षण यंत्री एवं कार्यपालन यंत्री द्वारा ही किया\nजावेगा ।\""
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        96.39,
        521.2,
        542.05,
        521.2,
        542.05,
        564.98,
        96.39,
        564.98
