        351.96
      ],
      "html": "<table><thead><tr><td>Name of the post</td><td>Station</td><td>Equivalent to the\npost</td><td>Service for which\nearmarked</td></tr></thead><tbody><tr><td>Joint Director, Level 13A in\nPay Matrix of 7th CPC</td><td>New\nDelhi</td><td>Deputy Inspector\nGeneral of Police</td><td>Indian Police\nService</td></tr></tbody></table>"
    },
