        293.02,
        495.04,
        313.22,
        113.05,
        313.22
      ],
      "text": "ग्रामपंचायत हिंजवडी ता.मुळशी जि.पुणे यांसकडुन श्री.श्याम हनुमंत वाकडकर यांचे मौजे हिंजवडी येथील सर्व्हे"
    },
    {
      "id": 16,
      "type": "text",
      "order": 16,
      "poly": [
        86.27,
        314.07,
        495.04,
        314.07,
        495.04,
        333.43,
        86.27,
        333.43
      ],
      "text": "नं.२६९/२/१अ यावर बांधकाम करण्यात येणाऱ्या राजलक्ष्मी रिअलकॉन रहिवासी प्रकल्पाचे बांधकाम पुर्ण झाले नंतर इमारतीला"
    },
    {
      "id": 17,
      "type": "text",
      "order": 17,
      "poly": [
        83.3,
        339.33,
        369.5,
        339.33,
        369.5,
        353.64,
        83.3,
        353.64
      ],
      "text": "मौजे हिंजवडी गावाच्या पाणी पुरवठा योजने द्वारे उपलब्धते नुसार पिण्याचे पाणी दिले जाईल."
    },
    {
      "id": 18,
      "type": "text",
      "order": 18,
      "poly": [
        82.11,
        357.85,
        495.04,
        357.85,
        495.04,
        370.48,
        82.11,
        370.48
      ],
      "text": "१. ग्रामपंचायत मुळा नदीकाठी दोन विहीरी आहेत, ज्या मधुन ग्रामपंचायतला ७०० के.एल.डी पाणी पुरवठा होतो. तसेच"
    },
    {
      "id": 19,
      "type": "text",
      "order": 19,
      "poly": [
        78.54,
        375.53,
        495.04,
        375.53,
        495.04,
        389.85,
        78.54,
        389.85
      ],
      "text": "एम.आय.डी.सी कडुन ग्रामपंचायतीला ६०० के.एल.डी पाणी पुरवठा होतो. सदर पाणी पुरवठ्यातुन ११५० के.एल.डी. पाणी पुरवठा"
    },
    {
      "id": 20,
      "type": "text",
      "order": 20,
      "poly": [
        77.95,
        394.06,
        258.82,
        394.06,
        258.82,
        407.53,
        77.95,
        407.53
      ],
      "text": "ग्रामपंचायतीच्या पाणी फिल्टर केंद्रावरुन गावात केला जातो."
    },
    {
      "id": 21,
      "type": "text",
      "order": 21,
      "poly": [
        79.14,
        415.11,
        332.01,
        415.11,
        332.01,
        430.26,
        79.14,
        430.26
      ],
      "text": "२.सन २०११ च्या जनगणनेनुसार हिंजवडी गावची लोकसंख्या ११४५९ एवढी आहे."
    },
    {
      "id": 22,
      "type": "text",
      "order": 22,
      "poly": [
        79.14,
        436.16,
        493.85,
        436.16,
        493.85,
        457.21,
        79.14,
        457.21
      ],
      "text": "३.ग्रामपंचायत हद्दीमध्ये प्रस्तावित वाढ लक्षात घेता, ग्रामपंचायतीनी येणाऱ्या काळात ग्रामपंचायत हद्दीत साधारण ३ पट लोकसंख्या"
    },
    {
      "id": 23,
      "type": "text",
      "order": 23,
      "poly": [
        77.35,
        453.84,
        426.62,
        453.84,
        426.62,
        476.57,
        77.35,
        476.57
      ],
      "text": "विचारधिन घेऊन त्यासाठी पाणीपुरवठा उपलब्ध करुन देण्यासाठी खालील पाणीपुरवठा योजना प्रस्तावित आहे."
    },
    {
      "id": 24,
      "type": "text",
      "order": 24,
      "poly": [
        78.54,
        475.73,
        492.66,
        475.73,
        492.66,
        500.99,
        78.54,
        500.99
      ],
      "text": "अ. ग्रामपंचायत प्रस्तावित विकसीत क्षेत्रातील प्रकल्पांस पाणी पुरवठ्यासाठी मांगीर बाबा पाणी पुरवठा योजना, वाकड पुणे."
    },
    {
      "id": 25,
      "type": "text",
      "order": 25,
      "poly": [
        77.35,
        495.94,
        492.66,
        495.94,
        492.66,
        523.72,
        77.35,
        523.72
      ],
      "text": "यांजकडुन अंदाजे २००० ते ३००० के.एल.डी पाणी घेण्याचा करार दि.३० मार्च २०२१ रोजी झाला असुन त्याची पुढील प्रक्रिया"
    },
    {
      "id": 26,
      "type": "text",
      "order": 26,
      "poly": [
        75.56,
        516.15,
        491.47,
        516.15,
        491.47,
        544.77,
        75.56,
        544.77
      ],
      "text": "सुरु आहे. सदर नियोजनाचा खर्च सुमारे ६० ते ८० लक्ष ग्रामस्थ व लोकवर्गणी मार्फत करण्यात येणार असुन, सदर योजना पुढील"
    },
    {
      "id": 27,
      "type": "text",
      "order": 27,
      "poly": [
        74.38,
        536.35,
        248.71,
        536.35,
        248.71,
        554.04,
        74.38,
        554.04
      ],
      "text": "२ ते ३ वर्षात पुर्ण करण्याचा ग्रामपंचायतीचा मानस आहे."
    },
    {
