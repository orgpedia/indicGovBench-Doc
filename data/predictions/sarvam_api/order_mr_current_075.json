      ],
      "text": "विषय:- माघी गणेशोत्सव - २०२३ साजरा करणेबाबत."
    },
    {
      "id": 3,
      "type": "text",
      "order": 3,
      "poly": [
        71.74,
        141.09,
        500.75,
        141.09,
        500.75,
        174.21,
        71.74,
        174.21
      ],
      "text": "माघी गणेशोत्सव २५ जानेवारी, २०२३ पासून साजरा होणार आहे. माघी गणेशोत्सवाबाबत\nमा.मनपा आयुक्तांनी पुढीलप्रमाणे मार्गदर्शक सूचना प्रसारित करण्यास मंजूरी दिली आहे –"
    },
    {
      "id": 4,
      "type": "text",
      "order": 4,
      "poly": [
        98.61,
        174.21,
        501.47,
        174.21,
        501.47,
        285.07,
        98.61,
        285.07
      ],
      "text": "1. आगामी माघी गणेशोत्सवादरम्यान असलेला अल्प कालावधी व तदनंतर लगेचच साजरा होणाऱ्या\nप्रजासत्ताक दिनाच्या पूर्वतयारीमध्ये पोलिसांची असलेली व्यस्तता, याबाबी विचारात घेवून माघी\nगणेशोत्सवासाठी प्राप्त होणाऱ्या अर्जांपैकी ज्या मंडळांना गतवर्षी परवानगी देण्यात आली आहे,\nअशा मंडळांचे अर्ज स्थानिक/वाहतूक पोलिसांकडे न पाठवता, मागील वर्षीची परवानगी ग्राह्य\nधरुन विभाग कार्यालयामार्फत छाननी करुन परवानगी देण्यात यावी. नव्याने / प्रथमतः अर्ज\nकरणाऱ्या मंडळांच्या अर्जाच्या बाबतीत मात्र स्थानिक/वाहतूक पोलिसांचे ना-हरकत प्रमाणपत्र\nघेण्यात यावे."
    },
    {
      "id": 5,
      "type": "text",
      "order": 5,
      "poly": [
        96.21,
        285.31,
        499.55,
        285.31,
        499.55,
        333.06,
        96.21,
        333.06
      ],
      "text": "2. विभागीय सहाय्यक आयुक्तांनी त्यांच्या अधिपत्याखालील विभागात माघी गणेशोत्सवादरम्यान\nउभारावयाच्या कृत्रिम तलावांची आवश्यकता पडताळावी व आवश्यक सुविधा उपलब्ध करुन\nदेण्यात याव्यात."
    },
    {
      "id": 6,
      "type": "text",
      "order": 6,
      "poly": [
        95.97,
        333.54,
        497.63,
        333.54,
        497.63,
        365.93,
        95.97,
        365.93
      ],
      "text": "3. माघी गणेशोत्सवादरम्यान मंडप उभारणीच्या परवानगीसाठी प्रतिवर्षीप्रमाणे असंगणकीय\nकार्यपद्धतीचा अवलंब करावा."
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        95.01,
        366.17,
        498.83,
        366.17,
        498.83,
        415.6,
        95.01,
        415.6
      ],
      "text": "4. कोविड-१९ किंवा त्याच्या विविध प्रकारांच्या प्रादूर्भावाचा पुनरुद्भवाचा संभाव्य धोका विचारात\nघेता, शासनाने उत्सव कालावधीत कोविड-१९ या साथरोगाच्या पार्श्वभूमीवर निर्बंध जारी केल्यास\nत्याचे पालन केले जाईल, अशा आशयाचे हमीपत्र मंडळांकडून स्वीकारावे."
    },
