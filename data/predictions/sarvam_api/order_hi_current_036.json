      "html": "<table><thead><tr><td rowspan=\"2\">क 0 सं०</td><td rowspan=\"2\">परियोजना का नाम</td><td rowspan=\"2\">अनुदान सं०/लेखाशीर्षक</td><td rowspan=\"2\">वित्तीय वर्ष2023-24 मेंप्राविधानित बजट</td><td rowspan=\"2\">शासन द्वारा प्रदत्त रयीकृति का संदर्भशासनादेशसं०- / ,दिनांक</td><td rowspan=\"2\">प्रशासकीय रयीकृति की लागत(a) /गठितअनुबंध कीलागत (b)</td><td rowspan=\"2\">अनुबंधितलागत केआधार पर कार्य कीपुनरीक्षितलागत</td><td rowspan=\"2\">अब तकआंटलआवंटन</td><td rowspan=\"2\">परियोजना पर आवंटन हेतु अवशेष धनराशि(पुनरीक्षित लागत सापेक्ष)(7-9)</td><td>परियोजना पर आवंटन हेतु अवमुक्त की जाने वाली पूर तायित धनराशि</td></tr><tr><td>वित्तीय वर्ष 2023-24 में</td><td>अनुदान सं०/ लेखाशीर्षक</td></tr><tr><td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td><td>9</td><td>10</td><td>11</td><td>12</td></tr></thead><tbody><tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr></tbody></table>"
    },
