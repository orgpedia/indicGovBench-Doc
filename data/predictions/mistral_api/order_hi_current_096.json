        245.07
      ],
      "text": "विषय:-अनुभव प्रमाण-पत्र निर्गत करने के सम्बन्ध में।"
    },
    {
      "id": 7,
      "type": "text",
      "order": 7,
      "poly": [
        110.79,
        262.45,
        556.43,
        262.45,
        556.43,
        376.71,
        110.79,
        376.71
      ],
      "text": "यह प्रकाश में आया है कि खण्डों द्वारा कार्य समाप्ति के उपरान्त जारी किये जाने वाले अनुभव प्रमाण-पत्र में पूर्ण विवरण जैसे कार्य समाप्ति की तिथि, कार्य पूर्ण होने की वास्तविक तिथि, कार्य की लागत, अतिरिक्त कार्य की लागत एवं कार्य के अन्तर्गत सम्पादित किये गये विभिन्न मदों की मात्रा एवं धनराशि के सम्बन्ध में पूर्ण स्थिति वर्णित न करने के कारण मूल्यांकन प्रक्रिया में असमंजस स्थिति उत्पन्न हो जाती है।"
    },
    {
      "id": 8,
      "type": "text",
      "order": 8,
      "poly": [
        110.79,
        388.3,
        556.43,
        388.3,
        556.43,
        431.35,
        110.79,
        431.35
      ],
      "text": "अतः एतद्वारा आदेश पारित किये जाते हैं कि भविष्य में निर्धारित संलग्न प्रारूप पर ही अनुभव प्रमाण-पत्र निर्गत करना सुनिश्चित किया जायेगा।"
    },
    {
      "id": 9,
      "type": "text",
      "order": 9,
      "poly": [
        173.17,
        442.11,
        478.46,
        442.11,
        478.46,
        461.15,
        173.17,
        461.15
      ],
      "text": "उक्त आदेशों का कड़ाई से अनुपालन किया जाना सुनिश्चित करें।"
    },
    {
      "id": 10,
      "type": "text",
      "order": 10,
      "poly": [
        110.79,
        466.95,
        238.82,
        466.95,
        238.82,
        482.68,
        110.79,
        482.68
      ],
      "text": "संलग्नक : उपरोक्तानुसार।"
    },
    {
      "id": 11,
      "type": "text",
      "order": 11,
      "poly": [
        416.09,
        467.78,
        556.43,
        467.78,
        556.43,
        543.12,
