      ],
      "html": "<table><thead><tr><td>स०क०</td><td>उपयुक्तता सूची क०/वसू</td><td>उपनिरीक्षक का नाम</td><td>जिला/इकाई का नाम</td><td>नवीन पदस्थापना इकाई</td><td>नाम पृथक किये जाने का कारण</td></tr></thead><tbody><tr><td>०१</td><td>३९२/१६३७</td><td>अशोक लहरी</td><td>जिला धार</td><td>अजाक पुलिस मुख्यालय, भोपाल</td><td>असंबंधी संज्ञा प्रभावशील होने से।</td></tr><tr><td>०२</td><td>४१२/१६७६</td><td>संजय खलको</td><td>जिला अनुपपुर</td><td>पीटीएस उमरिया</td><td>असंबंधी संज्ञा प्रभावशील होने से।</td></tr><tr><td>०३</td><td>४४९/१७३९</td><td>मोहित लाल सोनवानी</td><td>जिला शहडोल</td><td>पुलिस दूरसंचार संगठन, मुख्यालय, भोपाल</td><td>विभागीय जो ०१/२४ लंबित होने से।</td></tr></tbody></table>"
    },
    {
      "id": 5,
      "type": "text",
