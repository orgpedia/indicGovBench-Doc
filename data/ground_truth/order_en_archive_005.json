      "html": "<table><thead></thead><tbody><tr><td>1.</td><td>Smt. Indira Gandhi</td><td>Prime Minister (All Ministries/Departments not specified below).</td></tr><tr><td>2.</td><td>Shri Pranab Kumar Mukherjee</td><td>Minister of Finance.</td></tr><tr><td>3.</td><td>Shri P.V. Narasimha Rao</td><td>Minister of External Affairs.</td></tr><tr><td>4.</td><td>Shri P.C. Sethi</td><td>Minister of Home Affairs.</td></tr><tr><td>5.</td><td>Shri Shiv Shankar</td><td>Minister of Energy.</td></tr><tr><td>6.</td><td>Shri R. Venkataraman</td><td>Minister of Defence.</td></tr><tr><td>7.</td><td>Shri A.B.A. Ghani Khan Chaudhuri</td><td>Minister of Railways.</td></tr><tr><td>8.</td><td>Shri S.B. Chavan</td><td>Minister of Planning.</td></tr><tr><td>9.</td><td>Shri Jagannath Kaushal</td><td>Minister of Law, Justice and Company Affairs.</td></tr><tr><td>10.</td><td>Shri Veerendra Patil</td><td>Minister of Labour &amp; Rehabilitation.</td></tr><tr><td>11.</td><td>Shri K. Vijaya Bhaskara Reddy</td><td>Minister without portfolio (temporarily holding charge of the M/o Shipping and Transport).</td></tr><tr><td>12.</td><td>Shri Vasant Sathe</td><td>Minister of Chemicals and Fertilizers.</td></tr><tr><td>13.</td><td>Shri B. Shankaranand</td><td>Minister of Health &amp; Family Welfare.</td></tr><tr><td>14.</td><td>Shri A.P. Sharma</td><td>Minister of Communications.</td></tr><tr><td>15.</td><td>Shri Bhishma Narain Singh</td><td>Minister of Civil Supplies &amp; Supply.</td></tr><tr><td>16.</td><td>Rao Birendra Singh</td><td>Minister of Agriculture.</td></tr><tr><td>17.</td><td>Shri Buta Singh</td><td>Minister of Parliamentary Affairs, Sports and Works and Housing.</td></tr><tr><td>18.</td><td>Shri Vishwanath Pratap Singh</td><td>Minister of Commerce.</td></tr><tr><td>19.</td><td>Shri Narayan Datt Tiwari</td><td>Minister of Industry and Steel and Mines.</td></tr></tbody></table>",
